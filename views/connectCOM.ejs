
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>เชื่อมต่อพอร์ตนักชก</title>
  <script src="/socket.io/socket.io.js"></script>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #121212, #1a1a1a);
      color: #fff;
      margin: 0;
      padding: 20px;
      overflow-x: hidden;
    }
    .container {
      max-width: 800px;
      margin: 0 auto;
    }
    h1 {
      color: #fff;
      border-left: 5px solid #007bff;
      padding-left: 15px;
      margin-bottom: 20px;
    }
    .port-selection {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      margin-bottom: 20px;
    }
    .port-selection div {
      flex: 1 1 45%;
      min-width: 300px;
      background: #181818;
      padding: 15px;
      border-radius: 10px;
      border: 2px solid #007bff;
    }
    .port-selection div.fighter2 {
      border-color: #6c757d;
    }
    .port-selection h2 {
      margin: 0 0 10px 0;
      font-size: 1.2em;
    }
    input[type="text"], button {
      padding: 10px;
      margin: 5px 0;
      border-radius: 6px;
      border: none;
      font-size: 1em;
    }
    input[type="text"] {
      width: calc(100% - 20px);
      background: #333;
      color: #fff;
    }
    button {
      background: #007bff;
      color: #fff;
      cursor: pointer;
      transition: background 0.2s, transform 0.2s;
    }
    button:hover {
      background: #0056b3;
      transform: scale(1.05);
    }
    button:disabled {
      background: #555;
      cursor: not-allowed;
      opacity: 0.6;
    }
    .connected { color: #00ff00; font-weight: bold; }
    .disconnected { color: #ff4444; font-weight: bold; }
    .error { color: #ff4444; font-style: italic; }
    .sensor-data { margin-top: 10px; background: #222; padding: 10px; border-radius: 6px; }
    @media (max-width: 768px) {
      .port-selection div {
        flex: 1 1 100%;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <%- include('partials/navbar') %>
    <h1>เชื่อมต่อพอร์ตนักชก</h1>
    <div class="port-selection">
      <div>
        <h2>นักชก 1</h2>
        <input type="text" id="comPort1" placeholder="เช่น COM4" />
        <button id="connectBtn" onclick="connectPort()">เชื่อมต่อ</button>
        <p>สถานะ: <span id="com1-status" class="disconnected">ไม่ได้เชื่อมต่อ</span></p>
        <p id="com1-error" class="error"></p>
        <div class="sensor-data">
          <p id="com1-data">ข้อมูลเซ็นเซอร์: รอข้อมูล...</p>
        </div>
      </div>
      <div class="fighter2">
        <h2>นักชก 2</h2>
        <input type="text" id="comPort2" placeholder="เช่น COM5" />
        <button id="connectBtn" onclick="connectPort()">เชื่อมต่อ</button>
        <p>สถานะ: <span id="com2-status" class="disconnected">ไม่ได้เชื่อมต่อ</span></p>
        <p id="com2-error" class="error"></p>
        <div class="sensor-data">
          <p id="com2-data">ข้อมูลเซ็นเซอร์: รอข้อมูล...</p>
        </div>
      </div>
    </div>
    <button onclick="disconnectPorts()" style="background-color: #dc3545;">ตัดการเชื่อมต่อทั้งหมด</button>
  </div>
  <script>
    const socket = io();
    const SOCKET_EVENTS = {
      CONNECTION_STATUS: 'connectionStatus',
      CONNECTION_ERROR: 'connectionError',
      COM_PORT_1_DATA: 'COM_PORT_1_DATA',
      COM_PORT_2_DATA: 'COM_PORT_2_DATA'
    };
    socket.on('connect', () => {
      console.log('Socket.IO connected');
      socket.emit('requestConnectionStatus');
    });
    socket.on(SOCKET_EVENTS.CONNECTION_STATUS, ({ fighterPort1, fighterPort2 }) => {
      console.log('📡 connectionStatus:', { fighterPort1, fighterPort2 });
      const com1StatusEl = document.getElementById('com1-status');
      const com2StatusEl = document.getElementById('com2-status');
      const com1ErrorEl = document.getElementById('com1-error');
      const com2ErrorEl = document.getElementById('com2-error');
      com1StatusEl.textContent = fighterPort1 ? `เชื่อมต่อ ${fighterPort1}` : 'ไม่ได้เชื่อมต่อ';
      com1StatusEl.className = fighterPort1 ? 'connected' : 'disconnected';
      com2StatusEl.textContent = fighterPort2 ? `เชื่อมต่อ ${fighterPort2}` : 'ไม่ได้เชื่อมต่อ';
      com2StatusEl.className = fighterPort2 ? 'connected' : 'disconnected';
      document.getElementById('connectBtn').disabled = fighterPort1 && fighterPort2;
      com1ErrorEl.textContent = '';
      com2ErrorEl.textContent = '';
    });
    socket.on(SOCKET_EVENTS.CONNECTION_ERROR, (message) => {
      console.error('🚫 Connection error:', message);
      const com1ErrorEl = document.getElementById('com1-error');
      const com2ErrorEl = document.getElementById('com2-error');
      if (message.includes('Fighter1')) {
        com1ErrorEl.textContent = message;
      } else if (message.includes('Fighter2')) {
        com2ErrorEl.textContent = message;
      } else {
        com1ErrorEl.textContent = message;
        com2ErrorEl.textContent = message;
      }
    });
    socket.on(SOCKET_EVENTS.COM_PORT_1_DATA, (data) => {
      console.log('COM_PORT_1_DATA:', data);
      const com1DataEl = document.getElementById('com1-data');
      com1DataEl.textContent = `ข้อมูลเซ็นเซอร์: ${JSON.stringify(data)}`;
    });
    socket.on(SOCKET_EVENTS.COM_PORT_2_DATA, (data) => {
      console.log('COM_PORT_2_DATA:', data);
      const com2DataEl = document.getElementById('com2-data');
      com2DataEl.textContent = `ข้อมูลเซ็นเซอร์: ${JSON.stringify(data)}`;
    });
    function connectPort() {
      const fighterPort1 = document.getElementById('comPort1').value.trim().toUpperCase();
      const fighterPort2 = document.getElementById('comPort2').value.trim().toUpperCase();
      const portRegex = /^COM\d+$/;
      if (!fighterPort1 || !portRegex.test(fighterPort1)) {
        alert('พอร์ตนักชก 1 ต้องอยู่ในรูปแบบ COM ตามด้วยตัวเลข (เช่น COM4)');
        return;
      }
      if (!fighterPort2 || !portRegex.test(fighterPort2)) {
        alert('พอร์ตนักชก 2 ต้องอยู่ในรูปแบบ COM ตามด้วยตัวเลข (เช่น COM5)');
        return;
      }
      if (fighterPort1 === fighterPort2) {
        alert('COM Port ต้องไม่ซ้ำกัน');
        return;
      }
      document.getElementById('connectBtn').disabled = true;
      socket.emit('connectCOMPorts', { fighterPort1, fighterPort2 });
    }
    function disconnectPorts() {
      socket.emit('disconnectCOMPorts');
      document.getElementById('comPort1').value = '';
      document.getElementById('comPort2').value = '';
      document.getElementById('connectBtn').disabled = false;
      document.getElementById('com1-data').textContent = 'ข้อมูลเซ็นเซอร์: รอข้อมูล...';
      document.getElementById('com2-data').textContent = 'ข้อมูลเซ็นเซอร์: รอข้อมูล...';
    }
    window.onload = () => {
      socket.emit('requestConnectionStatus');
    };
  </script>
</body>
</html>
