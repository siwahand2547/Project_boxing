<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>เชื่อมต่อพอร์ตนักชก</title>
    <script src="/socket.io/socket.io.js"></script>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #f8f9fa;                  /* เทาอ่อนพื้นหลัง */
            --card-bg: #ffffff;             /* การ์ดขาว */
            --text: #1f2937;                /* ตัวอักษรหลัก */
            --text-muted: #6b7280;
            --border: #e5e7eb;              /* เส้นขอบอ่อน */
            --accent: #3b82f6;              /* น้ำเงินหลัก */
            --accent-hover: #2563eb;
            --success: #10b981;             /* เขียว connected */
            --danger: #ef4444;
            --danger-hover: #dc2626;
            --shadow: 0 4px 12px rgba(0, 0, 0, 0.06);
            --shadow-hover: 0 10px 20px rgba(0, 0, 0, 0.1);
            --input-bg: #ffffff;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background: var(--bg);
            color: var(--text);
            margin: 0;
            min-height: 100vh;
            padding: 2rem 1.5rem;
            line-height: 1.6;
        }

        .container {
            max-width: 1000px;
            margin: 0 auto;
        }

        h1 {
            font-size: 2rem;
            font-weight: 600;
            color: #111827;
            margin: 0 0 2.5rem 0;
            padding-left: 1rem;
            border-left: 5px solid var(--accent);
        }

        .port-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
            gap: 1.75rem;
            margin-bottom: 2.5rem;
        }

        .port-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1.75rem;
            box-shadow: var(--shadow);
            transition: all 0.25s ease;
        }

        .port-card:hover {
            border-color: var(--accent);
            box-shadow: var(--shadow-hover);
            transform: translateY(-4px);
        }

        .port-card.fighter2 {
            border-left: 4px solid #9ca3af; /* เทาอ่อนสำหรับนักชก 2 */
        }

        .port-card h2 {
            margin: 0 0 1.25rem 0;
            font-size: 1.35rem;
            color: #111827;
            font-weight: 600;
        }

        .input-group {
            margin-bottom: 1.25rem;
            display: flex;
            gap: 0.75rem;
            align-items: center;
        }

        input[type="text"] {
            flex: 1;
            padding: 0.85rem 1.2rem;
            background: var(--input-bg);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text);
            font-size: 1rem;
            transition: all 0.2s ease;
            box-shadow: inset 0 1px 3px rgba(0,0,0,0.03);
        }

        input[type="text"]:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(59,130,246,0.12);
        }

        input[type="text"]::placeholder {
            color: var(--text-muted);
        }

        .btn {
            padding: 0.85rem 1.4rem;
            border: none;
            border-radius: 8px;
            font-size: 0.95rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-primary {
            background: var(--accent);
            color: white;
        }

        .btn-primary:hover:not(:disabled) {
            background: var(--accent-hover);
            transform: translateY(-1px);
        }

        .btn-primary:disabled {
            background: #d1d5db;
            color: #6b7280;
            cursor: not-allowed;
        }

        .btn-danger {
            background: var(--danger);
            color: white;
            margin-top: 0.75rem;
        }

        .btn-danger:hover:not(:disabled) {
            background: var(--danger-hover);
        }

        .status-line {
            margin: 1rem 0;
            font-size: 1rem;
            font-weight: 500;
        }

        .status {
            font-weight: 600;
        }

        .connected { color: var(--success); }
        .disconnected { color: var(--danger); }

        .error {
            color: var(--danger);
            font-size: 0.9rem;
            min-height: 1.3rem;
            margin: 0.5rem 0 1rem;
        }

        .sensor-data {
            background: #f9fafb;
            padding: 1.25rem;
            border-radius: 8px;
            font-family: 'Consolas', 'Courier New', monospace;
            font-size: 0.95rem;
            min-height: 100px;
            white-space: pre-wrap;
            word-break: break-all;
            border: 1px solid var(--border);
            box-shadow: inset 0 1px 3px rgba(0,0,0,0.03);
        }

        @media (max-width: 768px) {
            body { padding: 1.5rem 1rem; }
            h1 { font-size: 1.75rem; }
            .port-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
  <div class="container">
    <%- include('partials/navbar') %>

    <h1>เชื่อมต่อพอร์ตนักชก</h1>

    <div class="port-grid">
      <!-- นักชก 1 -->
      <div class="port-card">
        <h2>นักชก 1</h2>
        <div class="input-group">
          <input 
            type="text" 
            id="comPort1" 
            placeholder="พิมพ์ COMx ตามที่เห็นในหน้าต่างเลือกพอร์ต (เช่น COM4)" 
            autocomplete="off" 
          />
          <button type="button" class="btn btn-primary" onclick="selectAndHintPort(1)">เลือกพอร์ต</button>
        </div>
        <button class="btn btn-primary" id="connectBtn1" onclick="connectFighter(1)">เชื่อมต่อนักชก 1</button>
        <button 
          class="btn btn-danger" 
          id="disconnectBtn1" 
          onclick="disconnectFighter(1)" 
          style="margin-top: 0.75rem; display: none;"
        >
          ตัดการเชื่อมต่อนักชก 1
        </button>

        <div class="status-line">
          สถานะ: <span id="com1-status" class="status disconnected">ไม่ได้เชื่อมต่อ</span>
        </div>
        <div class="error" id="com1-error"></div>

        <div class="sensor-data">
          <span id="com1-data">ข้อมูลเซ็นเซอร์: รอข้อมูล...</span>
        </div>
      </div>

      <!-- นักชก 2 -->
      <div class="port-card fighter2">
        <h2>นักชก 2</h2>
        <div class="input-group">
          <input 
            type="text" 
            id="comPort2" 
            placeholder="พิมพ์ COMx ตามที่เห็นในหน้าต่างเลือกพอร์ต (เช่น COM4)" 
            autocomplete="off" 
          />
          <button type="button" class="btn btn-primary" onclick="selectAndHintPort(2)">เลือกพอร์ต</button>
        </div>
        <button class="btn btn-primary" id="connectBtn2" onclick="connectFighter(2)">เชื่อมต่อนักชก 2</button>
        <button 
          class="btn btn-danger" 
          id="disconnectBtn2" 
          onclick="disconnectFighter(2)" 
          style="margin-top: 0.75rem; display: none;"
        >
          ตัดการเชื่อมต่อนักชก 2
        </button>

        <div class="status-line">
          สถานะ: <span id="com2-status" class="status disconnected">ไม่ได้เชื่อมต่อ</span>
        </div>
        <div class="error" id="com2-error"></div>

        <div class="sensor-data">
          <span id="com2-data">ข้อมูลเซ็นเซอร์: รอข้อมูล...</span>
        </div>
      </div>
    </div>

    <button class="btn btn-danger" onclick="disconnectPorts()">ตัดการเชื่อมต่อทั้งหมด</button>
  </div>

  <script>
    // JavaScript เดิมทั้งหมดยังคงเหมือนเดิม ไม่มีการเปลี่ยนแปลงใด ๆ
    const socket = io();

    const SOCKET_EVENTS = {
      CONNECTION_STATUS: 'connectionStatus',
      CONNECTION_ERROR: 'connectionError',
      COM_PORT_1_DATA: 'COM_PORT_1_DATA',
      COM_PORT_2_DATA: 'COM_PORT_2_DATA'
    };

    socket.on('connect', () => {
      socket.emit('requestConnectionStatus');
    });

    socket.on(SOCKET_EVENTS.CONNECTION_STATUS, ({ fighterPort1, fighterPort2 }) => {
      const status1 = document.getElementById('com1-status');
      const btnConnect1 = document.getElementById('connectBtn1');
      const btnDisconnect1 = document.getElementById('disconnectBtn1');
      const error1 = document.getElementById('com1-error');

      if (fighterPort1) {
        status1.textContent = `เชื่อมต่อ ${fighterPort1}`;
        status1.className = 'status connected';
        btnConnect1.disabled = true;
        btnConnect1.textContent = 'เชื่อมต่อแล้ว';
        btnDisconnect1.style.display = 'inline-block';
        error1.textContent = '';
      } else {
        status1.textContent = 'ไม่ได้เชื่อมต่อ';
        status1.className = 'status disconnected';
        btnConnect1.disabled = false;
        btnConnect1.textContent = 'เชื่อมต่อนักชก 1';
        btnDisconnect1.style.display = 'none';
      }

      const status2 = document.getElementById('com2-status');
      const btnConnect2 = document.getElementById('connectBtn2');
      const btnDisconnect2 = document.getElementById('disconnectBtn2');
      const error2 = document.getElementById('com2-error');

      if (fighterPort2) {
        status2.textContent = `เชื่อมต่อ ${fighterPort2}`;
        status2.className = 'status connected';
        btnConnect2.disabled = true;
        btnConnect2.textContent = 'เชื่อมต่อแล้ว';
        btnDisconnect2.style.display = 'inline-block';
        error2.textContent = '';
      } else {
        status2.textContent = 'ไม่ได้เชื่อมต่อ';
        status2.className = 'status disconnected';
        btnConnect2.disabled = false;
        btnConnect2.textContent = 'เชื่อมต่อนักชก 2';
        btnDisconnect2.style.display = 'none';
      }
    });

    socket.on(SOCKET_EVENTS.CONNECTION_ERROR, (message) => {
      if (message.includes('Fighter1') || message.includes('1')) {
        document.getElementById('com1-error').textContent = message;
      } else if (message.includes('Fighter2') || message.includes('2')) {
        document.getElementById('com2-error').textContent = message;
      } else {
        document.getElementById('com1-error').textContent = message;
        document.getElementById('com2-error').textContent = message;
      }
    });

    socket.on(SOCKET_EVENTS.COM_PORT_1_DATA, (data) => {
      document.getElementById('com1-data').textContent = `ข้อมูลเซ็นเซอร์: ${JSON.stringify(data, null, 2)}`;
    });

    socket.on(SOCKET_EVENTS.COM_PORT_2_DATA, (data) => {
      document.getElementById('com2-data').textContent = `ข้อมูลเซ็นเซอร์: ${JSON.stringify(data, null, 2)}`;
    });

    function connectFighter(fighterNum) {
      const inputId = `comPort${fighterNum}`;
      const btnId = `connectBtn${fighterNum}`;
      const port = document.getElementById(inputId).value.trim().toUpperCase();

      if (!port || !/^COM\d+$/.test(port)) {
        alert(`กรุณากรอกพอร์ตนักชก ${fighterNum} ให้ถูกต้อง (เช่น COM4)`);
        return;
      }

      const eventName = fighterNum === 1 ? 'connectFighter1' : 'connectFighter2';

      socket.emit(eventName, { port });

      const btn = document.getElementById(btnId);
      btn.disabled = true;
      btn.textContent = 'กำลังเชื่อมต่อ...';
    }

    function disconnectFighter(fighterNum) {
      const eventName = fighterNum === 1 ? 'disconnectFighter1' : 'disconnectFighter2';
      socket.emit(eventName);

      const btnConnect = document.getElementById(`connectBtn${fighterNum}`);
      const btnDisconnect = document.getElementById(`disconnectBtn${fighterNum}`);
      btnConnect.disabled = false;
      btnConnect.textContent = `เชื่อมต่อนักชก ${fighterNum}`;
      btnDisconnect.style.display = 'none';

      document.getElementById(`com${fighterNum}-data`).textContent = 'ข้อมูลเซ็นเซอร์: รอข้อมูล...';
    }

    function disconnectPorts() {
      socket.emit('disconnectCOMPorts');
      document.getElementById('comPort1').value = '';
      document.getElementById('comPort2').value = '';
      document.getElementById('connectBtn1').disabled = false;
      document.getElementById('connectBtn1').textContent = 'เชื่อมต่อนักชก 1';
      document.getElementById('connectBtn2').disabled = false;
      document.getElementById('connectBtn2').textContent = 'เชื่อมต่อนักชก 2';
      document.getElementById('com1-data').textContent = 'ข้อมูลเซ็นเซอร์: รอข้อมูล...';
      document.getElementById('com2-data').textContent = 'ข้อมูลเซ็นเซอร์: รอข้อมูล...';
    }

    async function selectAndHintPort(fighterNumber) {
      if (!('serial' in navigator)) {
        alert('เบราว์เซอร์ไม่รองรับการเลือกพอร์ตอัตโนมัติ\nกรุณาใช้ Chrome หรือ Edge ล่าสุด และเปิดเว็บด้วย HTTPS');
        return;
      }

      try {
        const port = await navigator.serial.requestPort();
        const info = port.getInfo?.() || {};

        let hint = '';
        if (info.usbVendorId && info.usbProductId) {
          const vid = info.usbVendorId.toString(16).padStart(4, '0').toUpperCase();
          const pid = info.usbProductId.toString(16).padStart(4, '0').toUpperCase();
          hint = `\n\nHint: อุปกรณ์ USB (VID: ${vid}, PID: ${pid})`;
        }

        alert(
          `เลือกพอร์ตเรียบร้อยแล้ว!\n\n` +
          `ชื่อพอร์ตจริง (เช่น COM4, COM5) แสดงในหน้าต่างที่เพิ่งเปิด\n` +
          `กรุณาดูชื่อนั้น แล้วพิมพ์ลงในช่องกรอกด้านบน (เช่น COM4)${hint}\n\n` +
          `หลังพิมพ์เสร็จ กดปุ่ม "เชื่อมต่อนักชก X" เพื่อเริ่มใช้งาน`
        );

      } catch (err) {
        if (err.name === 'NotFoundError') {
          alert('ไม่ได้เลือกพอร์ตใด ๆ');
        } else {
          alert('เกิดข้อผิดพลาด: ' + (err.message || 'ไม่ทราบสาเหตุ'));
        }
      }
    }

    window.onload = () => {
      socket.emit('requestConnectionStatus');
    };
  </script>
</body>
</html>