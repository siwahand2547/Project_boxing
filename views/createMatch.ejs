<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>สร้างการแข่งขัน</title>

  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #f8f9fa;
      --card-bg: #ffffff;
      --text: #1f2937;
      --text-muted: #6b7280;
      --border: #e5e7eb;
      --accent: #3b82f6;
      --accent-hover: #2563eb;
      --success: #10b981;
      --danger: #ef4444;
      --warning: #f59e0b;
      --shadow: 0 4px 12px rgba(0, 0, 0, 0.06);
      --shadow-hover: 0 10px 20px rgba(0, 0, 0, 0.1);
    }

    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text);
      margin: 0;
      padding: 2.5rem 1.5rem;
      line-height: 1.6;
    }

    .container {
      max-width: 600px;
      margin: 0 auto;
    }

    h1 {
      font-size: 2rem;
      font-weight: 600;
      color: #111827;
      text-align: center;
      margin: 0 0 2.5rem 0;
    }

    .status-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem;
      margin-bottom: 2rem;
      box-shadow: var(--shadow);
    }

    .status-card p {
      margin: 0 0 1rem 0;
      font-size: 1.1rem;
      font-weight: 500;
      color: #374151;
    }

    .status-line {
      margin: 0.75rem 0;
      font-size: 1rem;
    }

    .connected {
      color: var(--success);
      font-weight: 600;
    }

    .disconnected {
      color: var(--danger);
      font-weight: 600;
    }

    #comNotice {
      margin-top: 1rem;
      padding: 1rem;
      background: #fefce8;
      border: 1px solid #fef08a;
      border-radius: 8px;
      color: #854d0e;
      font-weight: 500;
      text-align: center;
      display: none;
    }

    #comNotice a {
      color: var(--accent);
      text-decoration: underline;
      font-weight: 600;
    }

    #comNotice a:hover {
      color: var(--accent-hover);
    }

    form {
      background: var(--card-bg);
      padding: 2rem;
      border-radius: 12px;
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
    }

    label {
      display: block;
      margin: 1.25rem 0 0.5rem;
      font-weight: 500;
      color: #374151;
      font-size: 0.95rem;
    }

    select, input[type="date"] {
      width: 100%;
      padding: 0.85rem 1rem;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: #ffffff;
      color: var(--text);
      font-size: 1rem;
      transition: all 0.2s ease;
      box-shadow: inset 0 1px 3px rgba(0,0,0,0.03);
    }

    select:focus, input[type="date"]:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(59,130,246,0.12);
    }

    button {
      margin-top: 2rem;
      width: 100%;
      padding: 1rem;
      background: var(--accent);
      color: white;
      font-size: 1.1rem;
      font-weight: 500;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    button:hover:not(:disabled) {
      background: var(--accent-hover);
      transform: translateY(-1px);
      box-shadow: 0 6px 16px rgba(59,130,246,0.25);
    }

    button:disabled {
      background: #d1d5db;
      color: #6b7280;
      cursor: not-allowed;
      transform: none;
    }

    #loadingOverlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.75);
      color: white;
      font-size: 1.5rem;
      font-weight: 600;
      display: none;
      justify-content: center;
      align-items: center;
      z-index: 9999;
    }

    .loadingContent {
      padding: 2rem 3rem;
      background: var(--card-bg);
      border-radius: 12px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.3);
      text-align: center;
      border: 1px solid var(--border);
    }

    @media (max-width: 576px) {
      body { padding: 1.5rem 1rem; }
      h1 { font-size: 1.75rem; }
      form { padding: 1.5rem; }
    }
  </style>
</head>
<body>

  <!-- Loading overlay -->
  <div id="loadingOverlay">
    <div class="loadingContent">
      🔄 กำลังเชื่อมต่อ COM กรุณารอสักครู่...
    </div>
  </div>

  <%- include('partials/navbar') %>

  <div class="container">
    <h1>สร้างการแข่งขันใหม่</h1>

    <div class="status-card">
      <p>สถานะอุปกรณ์:</p>
      <div class="status-line">
        ➤ นักชกคนที่ 1: <span id="fighter1-status" class="disconnected">ยังไม่เชื่อมต่อ</span>
      </div>
      <div class="status-line">
        ➤ นักชกคนที่ 2: <span id="fighter2-status" class="disconnected">ยังไม่เชื่อมต่อ</span>
      </div>
    </div>

    <div id="comNotice">
      ⚠️ กรุณา <a href="/connectCOM">ไปเชื่อมต่อพอร์ต COM ก่อน</a> จึงจะสามารถสร้างการแข่งขันได้
    </div>

    <form id="matchForm" method="POST" action="/match/create">
      <div class="form-group">
        <label for="fight_date">เลือกวันแข่งขัน</label>
        <input type="date" id="fight_date" name="fight_date" required />
      </div>

      <div class="form-group">
        <label for="fighter1">เลือกนักชกคนที่ 1</label>
        <select id="fighter1" name="fighter1_id" required>
          <% fighters.forEach(f => { %>
            <option value="<%= f.id %>"><%= f.name %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="fighter2">เลือกนักชกคนที่ 2</label>
        <select id="fighter2" name="fighter2_id" required>
          <% fighters.forEach(f => { %>
            <option value="<%= f.id %>"><%= f.name %></option>
          <% }) %>
        </select>
      </div>

      <button type="submit" id="testBtn" disabled>👊 สร้างการแข่งขัน</button>
    </form>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();

    const updateStatus = ({ fighterPort1, fighterPort2 }) => {
      const fighter1Status = document.getElementById('fighter1-status');
      const fighter2Status = document.getElementById('fighter2-status');
      const testBtn = document.getElementById('testBtn');
      const notice = document.getElementById('comNotice');

      const connected1 = !!fighterPort1;
      const connected2 = !!fighterPort2;

      fighter1Status.textContent = connected1 
        ? `เชื่อมต่อแล้ว (${fighterPort1})` 
        : 'ยังไม่เชื่อมต่อ';
      fighter1Status.className = connected1 ? 'connected' : 'disconnected';

      fighter2Status.textContent = connected2 
        ? `เชื่อมต่อแล้ว (${fighterPort2})` 
        : 'ยังไม่เชื่อมต่อ';
      fighter2Status.className = connected2 ? 'connected' : 'disconnected';

      const isBothConnected = connected1 && connected2;
      testBtn.disabled = !isBothConnected;
      notice.style.display = isBothConnected ? 'none' : 'block';
    };

    socket.on('connectionStatus', updateStatus);

    // โหลดสถานะตอนเปิดหน้า
    window.onload = () => {
      socket.emit('requestConnectionStatus');
    };
  </script>

</body>
</html>