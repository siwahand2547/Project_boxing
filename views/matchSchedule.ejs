<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ตารางการแข่งขัน</title>
  <link rel="stylesheet" href="/styles.css">

  <!-- Flatpickr -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #f8f9fa;
      --card-bg: #ffffff;
      --text: #1f2937;
      --text-muted: #6b7280;
      --border: #e5e7eb;
      --accent: #3b82f6;
      --accent-hover: #2563eb;
      --danger: #ef4444;
      --danger-hover: #dc2626;
      --shadow: 0 4px 12px rgba(0, 0, 0, 0.06);
      --shadow-hover: 0 10px 20px rgba(0, 0, 0, 0.1);
      --table-even: #f9fafb;
      --table-hover: #f1f5f9;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      margin: 0;
      padding: 2.5rem 1.5rem;
      line-height: 1.6;
    }

    .container {
      max-width: 1400px;
      margin: 0 auto;
    }

    h1 {
      font-size: 2.25rem;
      font-weight: 600;
      color: #111827;
      text-align: center;
      margin: 0 0 2.5rem 0;
    }

    /* กลุ่มฟิลเตอร์ */
    .filter-section {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem;
      margin-bottom: 2.5rem;
      box-shadow: var(--shadow);
    }

    .filter-container {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      align-items: center;
      justify-content: center;
    }

    .filter-item {
      flex: 1;
      min-width: 220px;
    }

    .filter-item input,
    .filter-item button {
      width: 100%;
      padding: 0.85rem 1.2rem;
      font-size: 1rem;
      border: 1px solid var(--border);
      border-radius: 8px;
      outline: none;
      transition: all 0.2s ease;
    }

    .filter-item input {
      background: #ffffff;
      box-shadow: inset 0 1px 3px rgba(0,0,0,0.04);
    }

    .filter-item input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(59,130,246,0.12);
    }

    .filter-item button {
      background: var(--accent);
      color: white;
      font-weight: 500;
      border: none;
      cursor: pointer;
    }

    .filter-item button:hover {
      background: var(--accent-hover);
    }

    .clear-btn {
      background: #6b7280 !important;
    }

    .clear-btn:hover {
      background: #4b5563 !important;
    }

    .error-message {
      color: var(--danger);
      font-size: 0.9rem;
      margin-top: 0.75rem;
      text-align: center;
      width: 100%;
      display: none;
    }

    /* ตารางหลัก */
   /* ตารางหลัก - ปรับใหม่ */
.fight-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  background: var(--card-bg);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: var(--shadow);
}

.fight-table th,
.fight-table td {
  padding: 1rem 1.2rem;
  text-align: center;
  border-bottom: 1px solid #e5e7eb;          /* เส้นอ่อนมาก (เทาอ่อน) */
  border-right: 1px solid #f0f0f0;           /* เส้นแนวตั้งอ่อน ๆ */
}

.fight-table th:last-child,
.fight-table td:last-child {
  border-right: none;                        /* ไม่ให้เส้นขวาสุดท้าย */
}

.fight-table th {
  background: #374151;                       /* เข้มขึ้น (เทาเข้ม) */
  color: #ffffff;                            /* ตัวอักษรขาวชัด */
  font-weight: 600;
  font-size: 0.95rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  border-bottom: 2px solid #4b5563;          /* เส้นใต้หัวตารางหนานิดเพื่อแยกชัด */
}

.fight-table tbody tr:nth-child(even) {
  background: #f9fafb;                       /* เทาอ่อนสลับแถว */
}

.fight-table tbody tr:hover {
  background: #f1f5f9;                       /* hover เบา ๆ */
}

.fight-table a {
  color: var(--accent);
  text-decoration: none;
  font-weight: 500;
}

.fight-table a:hover {
  color: var(--accent-hover);
  text-decoration: underline;
}

.delete-btn {
  background: #fef2f2;
  color: var(--danger);
  border: 1px solid #fecaca;
  padding: 0.5rem 1rem;
  border-radius: 6px;
  font-size: 0.9rem;
  cursor: pointer;
  transition: all 0.2s ease;
}

.delete-btn:hover {
  background: #fee2e2;
}
  

    /* สถานะว่าง */
    .empty-state {
      text-align: center;
      padding: 5rem 1rem;
      background: var(--card-bg);
      border-radius: 12px;
      border: 1px dashed var(--border);
      color: var(--text-muted);
      font-size: 1.15rem;
      margin-top: 2rem;
    }
  </style>
</head>
<body>

  <%- include('partials/navbar') %>

  <div class="container">

    <h1>ตารางการแข่งขัน</h1>

    <!-- กลุ่มฟิลเตอร์ -->
    <div class="filter-section">
      <div class="filter-container">
        <div class="filter-item">
          <input 
            type="text" 
            id="dateFilterSingle" 
            placeholder="เลือกวันที่ (YYYY-MM-DD)"
          >
        </div>

        <div class="filter-item">
          <input 
            type="text" 
            id="dateFilterMulti" 
            placeholder="หลายวัน เช่น 2025-01-01,2025-01-02"
            oninput="filterMatches()"
          >
        </div>

        <div class="filter-item">
          <button onclick="clearFilters()" class="clear-btn">ล้างตัวกรอง</button>
        </div>
      </div>

      <div id="errorMessage" class="error-message">
        วันที่ไม่ถูกต้อง กรุณาใช้รูปแบบ YYYY-MM-DD
      </div>
    </div>

    <!-- ตาราง -->
    <table class="fight-table" id="fightTable">
      <thead>
        <tr>
          <th>คู่ที่</th>
          <th>วันที่แข่งขัน</th>
          <th>นักชกคนที่ 1</th>
          <th>นักชกคนที่ 2</th>
          <th>เปรียบเทียบข้อมูล</th>
          <th>การจัดการ</th>
        </tr>
      </thead>
      <tbody>
        <% fights.forEach(fight => { %>
          <tr data-date="<%= fight.fightDate %>">
            <td data-label="คู่ที่"><%= fight.matchCount %></td>
            <td data-label="วันที่แข่งขัน"><%= fight.fightDate %></td>
            <td data-label="นักชกคนที่ 1"><%= fight.fighter1 %></td>
            <td data-label="นักชกคนที่ 2"><%= fight.fighter2 %></td>
            <td data-label="เปรียบเทียบข้อมูล">
              <a href="/fights/data/<%= fight.id %>">ดูข้อมูล</a>
            </td>
            <td data-label="การจัดการ">
              <form method="POST" action="/match/delete/<%= fight.id %>" style="display:inline;">
                <button 
                  type="submit" 
                  class="delete-btn"
                  onclick="return confirm('คุณแน่ใจหรือไม่ว่าต้องการลบแมตช์นี้?')"
                >
                  ลบ
                </button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <% if (fights.length === 0) { %>
      <div class="empty-state">
        <p>ยังไม่มีแมตช์การแข่งขันในระบบ</p>
        <a href="/match/create" style="margin-top:1.5rem; display:inline-block;" class="action-btn" 
           style="background:#eff6ff; color:var(--accent); border:1px solid #bfdbfe; padding:0.7rem 1.5rem; border-radius:6px; text-decoration:none;">
          + สร้างการแข่งขันใหม่
        </a>
      </div>
    <% } %>

  </div>

  <script>
    // Flatpickr
    flatpickr('#dateFilterSingle', {
      dateFormat: 'Y-m-d',
      allowInput: true,
      enable: [<% availableDates.forEach((date, i) => { %>"<%= date %>"<% if (i < availableDates.length-1) { %>, <% } %><% }) %>],
      onChange: function() {
        filterMatches();
      }
    });

    function filterMatches() {
      const singleDate = document.getElementById('dateFilterSingle').value.trim();
      const multiDate = document.getElementById('dateFilterMulti').value.trim();
      const errorMsg = document.getElementById('errorMessage');
      const rows = document.querySelectorAll('#fightTable tbody tr');

      let inputDates = [];

      if (singleDate) inputDates.push(singleDate);

      if (multiDate) {
        const dates = multiDate.split(',').map(d => d.trim()).filter(d => d);
        dates.forEach(date => {
          if (/^\d{4}-\d{2}-\d{2}$/.test(date)) {
            inputDates.push(date);
          }
        });
      }

      if (inputDates.length === 0 && multiDate) {
        errorMsg.style.display = 'block';
        rows.forEach(row => row.style.display = 'none');
        return;
      } else {
        errorMsg.style.display = 'none';
      }

      if (inputDates.length === 0) {
        rows.forEach(row => row.style.display = '');
        return;
      }

      rows.forEach(row => {
        const rowDate = row.getAttribute('data-date');
        row.style.display = inputDates.includes(rowDate) ? '' : 'none';
      });
    }

    function clearFilters() {
      document.getElementById('dateFilterSingle').value = '';
      document.getElementById('dateFilterMulti').value = '';
      document.getElementById('errorMessage').style.display = 'none';
      document.querySelectorAll('#fightTable tbody tr').forEach(row => {
        row.style.display = '';
      });
      flatpickr('#dateFilterSingle').clear();
    }
  </script>

</body>
</html>