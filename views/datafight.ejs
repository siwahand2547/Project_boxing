<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>เปรียบเทียบนักชก</title>
  <script src="/socket.io/socket.io.js"></script>
<style>
  :root {
  --bg: #f8f9fa;
  --card-bg: #ffffff;
  --text: #1f2937;
  --text-muted: #6b7280;
  --border: #e2e8f0;
  --table-border: #e5e7eb;
  --header-bg: #4b5563;          /* ปรับอ่อนลงจาก #374151 → เทาเข้มกลาง สวยงามขึ้น */
  --header-text: #ffffff;
  --accent: #3b82f6;
  --accent-hover: #2563eb;
  --danger: #ef4444;
  --danger-hover: #dc2626;
  --success: #10b981;
  --even-row: #f9fafb;
  --hover-row: #f1f5f9;
  --shadow: 0 4px 12px rgba(0, 0, 0, 0.05);
}
  body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    background: var(--bg);
    color: var(--text);
    margin: 0;
    padding: 20px;
    overflow-x: hidden;
  }

  h1, h2, h3 {
    color: #111827;
    border-left: 5px solid var(--accent);
    padding-left: 15px;
    margin-bottom: 20px;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
  }

  table.fighter-info, table.realtime-table, table.fight-rounds {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
    background: var(--card-bg);
    box-shadow: var(--shadow);
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--border);
  }

table.fighter-info th, 
table.realtime-table th, 
table.fight-rounds th,
.fight-table th {                  /* เพิ่ม .fight-table th เพื่อครอบคลุมหน้าอื่นด้วย */
  background: var(--header-bg);
  color: var(--header-text);
  padding: 12px;
  text-align: center;
  font-weight: 600;
  font-size: 0.95rem;
  text-transform: uppercase;
  letter-spacing: 0.4px;
  border-bottom: 2px solid #6b7280;  /* เส้นใต้อ่อนลง ให้ดูนุ่มนวล */
}

  table.fighter-info td, table.realtime-table td, table.fight-rounds td {
    padding: 12px;
    text-align: center;
    border-top: 1px solid var(--table-border);
    color: var(--text);
  }

  .fighter-info-container {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 20px;
  }

  .fighter-info {
    flex: 1 1 45%;
    min-width: 300px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  img {
    width: 100px;
    height: 100px;
    object-fit: cover;
    border-radius: 6px;
    box-shadow: 0 0 8px rgba(0,0,0,0.08);
  }

  .realtime-container {
    flex: 1 1 45%;
    min-width: 300px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 15px;
    box-sizing: border-box;
    max-height: 300px;
    overflow-y: auto;
    margin-bottom: 20px;
    box-shadow: var(--shadow);
  }

  .realtime-container.fighter2 {
    border-left: 4px solid #6b7280;
  }

  .realtime-container h2 {
    color: #111827;
    margin: 0 0 10px 0;
    font-size: 1.2em;
    font-weight: 600;
  }

  .watch-btn {
    background: var(--accent);
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .watch-btn:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
  }

  button {
    font-size: 14px;
    margin: 5px;
    border: none;
    background: #e5e7eb;
    color: #374151;
    padding: 10px 16px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  button:hover {
    background: #d1d5db;
  }

  button:disabled {
    background: #e5e7eb;
    color: #9ca3af;
    cursor: not-allowed;
    opacity: 0.7;
  }

  #clipModal, #videoModal, #summaryModal, #cameraTestModal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--modal-bg);
    z-index: 1000;
    justify-content: center;
    align-items: center;
    flex-direction: column;
  }

  #clipModal .modal-content, #videoModal .modal-content, #summaryModal .modal-content, #cameraTestModal .modal-content {
    background: var(--card-bg);
    padding: 20px;
    border-radius: 12px;
    max-width: 90%;
    max-height: 90vh;
    overflow: auto;
    position: relative;
    box-shadow: 0 20px 60px rgba(0,0,0,0.25);
    border: 1px solid var(--border);
  }

  #clipModal video {
    max-width: 45%;
    max-height: 70vh;
    border-radius: 8px;
    background: #000;
    box-shadow: 0 0 15px rgba(0,0,0,0.15);
    margin: 10px;
  }

  #videoModal video {
    max-width: 800px;
    max-height: 80vh;
    border-radius: 8px;
  }

  #clipModal h3 {
    color: #111827;
    margin: 10px 0 5px;
    font-size: 1.2em;
  }

  #timestampButtons button {
    background: var(--accent);
    color: white;
    border: none;
    padding: 8px 12px;
    margin: 5px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  #timestampButtons button:hover {
    background: var(--accent-hover);
  }

  #timestampButtons button.active {
    background: var(--success);
  }

  .modal-close {
    position: absolute;
    top: 15px;
    right: 15px;
    color: #6b7280;
    font-size: 28px;
    cursor: pointer;
    transition: color 0.2s;
  }

  .modal-close:hover {
    color: var(--accent);
  }

  #summaryModal .modal-content {
    max-width: 800px;
    width: 90%;
  }

  #summaryContent {
    max-height: 60vh;
    overflow-y: auto;
    padding: 15px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: #ffffff;
  }

  #summaryContent table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 15px;
  }

  #summaryContent th, #summaryContent td {
    padding: 8px;
    text-align: center;
    border: 1px solid var(--table-border);
  }

  #summaryContent th {
    background: var(--header-bg);
    color: var(--header-text);
    font-weight: 600;
  }

  #summaryContent tbody tr:nth-child(even) {
    background: var(--even-row);
  }

  .connected { color: var(--success); font-weight: bold; }
  .disconnected { color: var(--danger); font-weight: bold; }

  /* ส่วน layout ใหม่ - ปรับสีให้เข้ากัน */
  .main-flex-layout {
    display: flex;
    flex-wrap: wrap;
    gap: 25px;
    margin-top: 20px;
    align-items: flex-start;
  }

  .left-main-content {
    flex: 3 1 750px;
    min-width: 0;
  }

  .right-cameras-sidebar {
    flex: 1 1 360px;
    max-width: 380px;
    position: sticky;
    top: 30px;
    align-self: flex-start;
  }

  .camera-box {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 15px;
    box-shadow: var(--shadow);
  }

  .camera-box h3 {
    margin: 0 0 12px;
    color: var(--text);
    text-align: center;
    font-size: 1.1em;
    font-weight: 600;
  }

  .camera-item {
    margin-bottom: 15px;
    text-align: center;
  }

  .camera-item small {
    display: block;
    color: var(--text-muted);
    margin-bottom: 6px;
  }

  .camera-item video {
    width: 100%;
    height: auto;
    max-height: 240px;
    background: #000;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }

  @media (max-width: 1100px) {
    .main-flex-layout {
      flex-direction: column;
    }
    .right-cameras-sidebar {
      position: static;
      max-width: 500px;
      margin: 0 auto 30px;
    }
  }

  @media (max-width: 768px) {
    .fighter-info, .realtime-container {
      flex: 1 1 100%;
    }
    #clipModal video {
      max-width: 90%;
    }
    #summaryModal .modal-content {
      max-width: 95%;
    }
  }

  #cameraTestModal .modal-content {
    background: var(--card-bg);
  }

  #cameraTestModal video {
    max-width: 45%;
    max-height: 70vh;
    border-radius: 8px;
    background: #000;
    box-shadow: 0 0 15px rgba(0,0,0,0.15);
    margin: 10px;
  }

  .timestamp-section {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 20px;
  }

  .timestamp-group {
    flex: 1 1 45%;
    min-width: 280px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 15px;
    box-shadow: var(--shadow);
  }

  .timestamp-group h4 {
    text-align: center;
    margin: 0 0 12px 0;
    color: var(--text);
    font-size: 1.1em;
    font-weight: 600;
  }

  .timestamp-group button {
    width: 100%;
    margin: 6px 0;
    padding: 10px;
    background: var(--accent);
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .timestamp-group button:hover {
    background: var(--accent-hover);
  }

  .timestamp-group button.active {
    background: var(--success);
    transform: scale(1.03);
  }
</style>
</head>
<body>

  <div class="container">

    <!-- Modal เดิมทั้งหมด (เหมือนเดิม 100%) -->
    <div id="cameraTestModal">
      <div class="modal-content">
        <span class="modal-close" onclick="closeCameraTestModal()">&times;</span>
        <h2>ทดสอบกล้อง</h2>
        <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
          <video id="testCam1" autoplay playsinline style="display: none;"></video>
          <video id="testCam2" autoplay playsinline style="display: none;"></video>
        </div>
        <button onclick="closeCameraTestModal()">ปิด</button>
      </div>
    </div>

    <div id="clipModal">
      <div class="modal-content">
        <span class="modal-close" onclick="closeClipModal()">&times;</span>
        <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
          <div style="text-align: center;">
            <h3>กล้อง 1</h3>
            <video id="clipVideo1" muted preload="auto" controls style="display: none;"></video>
          </div>
          <div style="text-align: center;">
            <h3>กล้อง 2</h3>
            <video id="clipVideo2" muted preload="auto" controls style="display: none;"></video>
          </div>
        </div>
        <div id="timestampButtons" style="margin-top: 15px; text-align: center;"></div>
      </div>
    </div>

    <div id="summaryModal">
      <div class="modal-content">
        <span class="modal-close" onclick="document.getElementById('summaryModal').style.display='none'">&times;</span>
        <h2>สรุปผลการแข่งขัน</h2>
        <div id="summaryContent">กำลังโหลดข้อมูล...</div>
        <button onclick="document.getElementById('summaryModal').style.display='none'" style="align-self: flex-end;">ปิด</button>
      </div>
    </div>

    <%- include('partials/navbar') %>

    <div class="main-flex-layout">

      <!-- ฝั่งซ้าย: ข้อมูลหลักทั้งหมด (เหมือนเดิม) -->
      <div class="left-main-content">

        <h1>เปรียบเทียบนักชก (ID: <%= schedulefightId %>)</h1>

        <div class="fighter-info-container">
          <div class="fighter-info">
            <table class="fighter-info">
              <thead><tr><th>ชื่อ</th><th>ค่าย</th><th>รุ่นน้ำหนัก</th><th>ภาพ</th></tr></thead>
              <tbody>
                <tr>
                  <td><%= fighter1.name %></td>
                  <td><%= fighter1.camp %></td>
                  <td><%= fighter1.weight_class %></td>
                  <td><img src="<%= fighter1.photo || '/uploads/default.jpg' %>" alt="fighter1"></td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="fighter-info">
            <table class="fighter-info">
              <thead><tr><th>ชื่อ</th><th>ค่าย</th><th>รุ่นน้ำหนัก</th><th>ภาพ</th></tr></thead>
              <tbody>
                <tr>
                  <td><%= fighter2.name %></td>
                  <td><%= fighter2.camp %></td>
                  <td><%= fighter2.weight_class %></td>
                  <td><img src="<%= fighter2.photo || '/uploads/default.jpg' %>" alt="fighter2"></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <p>
          สถานะพอร์ต COM:<br />
          ➤ <span id="fighter1-port">กำลังโหลด...</span>: <span id="fighter1-status" class="disconnected">ยังไม่เชื่อมต่อ</span><br />
          ➤ <span id="fighter2-port">กำลังโหลด...</span>: <span id="fighter2-status" class="disconnected">ยังไม่เชื่อมต่อ</span>
        </p>

        <div class="fighter-info-container">
          <div class="realtime-container" id="realtime1">
            <h2 id="fighter1-header">ข้อมูล Real-time <%= fighter1.name %></h2>
            <table class="realtime-table" id="fighter1Table">
              <thead><tr><th>เวลา</th><th>ตำแหน่ง</th><th>ข้อมูล (N)</th></tr></thead>
              <tbody></tbody>
            </table>
          </div>
          <div class="realtime-container fighter2" id="realtime2">
            <h2 id="fighter2-header">ข้อมูล Real-time <%= fighter2.name %></h2>
            <table class="realtime-table" id="fighter2Table">
              <thead><tr><th>เวลา</th><th>ตำแหน่ง</th><th>ข้อมูล (N)</th></tr></thead>
              <tbody></tbody>
            </table>
          </div>
        </div>

        <div style="text-align: center; margin: 20px 0;">
          <button onclick="startRecording()">🎥 เริ่มการแข่งขัน</button>
          <button onclick="stopRecording()" id="stopBtn" disabled>⛔ จบการแข่งขัน</button>
          <button id="btnSummary">📊 สรุปผลการแข่งขัน</button>
          <button onclick="swapPorts()">🔄 สลับพอร์ตนักชก</button>
          <button onclick="testCameras()">📸 ทดสอบกล้อง</button>
        </div>

        <h2>ข้อมูลการแข่งขันย้อนหลัง</h2>
        <div id="fightRoundsContainer">
          <% Object.keys(fightDataGrouped).forEach(round => { %>
            <table class="fight-rounds">
              <thead>
                <tr><th colspan="5">ยกที่ <%= round %></th></tr>
                <tr><th>เวลาที่โดน</th><th>ระยะเวลา</th><th>นักชก</th><th>รายละเอียด</th><th>คลิปกล้อง</th></tr>
              </thead>
              <tbody>
                <% fightDataGrouped[round].forEach(item => { 
                  const fighterName = fighterIdNameMap[item.fighterid] || item.fighterid;
                  const timestamps = fightDataGrouped[round].map(t => ({ timehit: t.timehit, detail: t.fighterdetail }));
                %>
                  <tr>
                    <td><%= item.timehit %></td>
                    <td><%= item.time %></td>
                    <td><%= fighterName %></td>
                    <td><%= item.fighterdetail %></td>
                    <td>
                      <% if (item.clipdetail && item.clipdetail2) { %>
                        <button class="watch-btn" onclick='openClipModal("<%= encodeURIComponent(item.clipdetail) %>", "<%= encodeURIComponent(item.clipdetail2) %>", "<%= encodeURIComponent(item.timehit) %>", <%= JSON.stringify(timestamps) %>, "<%= round %>")'>ดูคลิป 2 มุม</button>
                      <% } else if (item.clipdetail) { %>
                        <button class="watch-btn" onclick='openClipModal("<%= encodeURIComponent(item.clipdetail) %>", "", "<%= encodeURIComponent(item.timehit) %>", <%= JSON.stringify(timestamps) %>, "<%= round %>")'>ดูกล้อง 1</button>
                      <% } else if (item.clipdetail2) { %>
                        <button class="watch-btn" onclick='openClipModal("", "<%= encodeURIComponent(item.clipdetail2) %>", "<%= encodeURIComponent(item.timehit) %>", <%= JSON.stringify(timestamps) %>, "<%= round %>")'>ดูกล้อง 2</button>
                      <% } else { %>
                        ไม่มีคลิป
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% }) %>
        </div>

      </div>

      <!-- ฝั่งขวา: กล้องเรียลไทม์ (sticky) -->
      <div class="right-cameras-sidebar">
        <div class="camera-box">
          <h3>มุมมองเรียลไทม์</h3>
          <div class="camera-item">
            <small>กล้อง 1</small>
            <video id="cam1" autoplay playsinline></video>
          </div>
          <div class="camera-item">
            <small>กล้อง 2</small>
            <video id="cam2" autoplay playsinline></video>
          </div>
        </div>
      </div>

    </div>

  </div>

  <script>
    const socket = io();
    let mediaRecorder1, mediaRecorder2;
    let recordedChunks1 = [], recordedChunks2 = [];
    let startTime = null;
    let realtimeData = [];
    let roundsData = [];
    let roundNumber = <%= typeof roundNumberStart !== 'undefined' ? roundNumberStart : 1 %>;
    let testStream1 = null, testStream2 = null;

    socket.on('connect', () => {
      console.log('Socket.IO connected');
      socket.emit('requestConnectionStatus');
    });

    socket.on('connectionStatus', (status) => {
      console.log('📡 Received connection status:', status); // เพิ่ม log เพื่อตรวจสอบข้อมูลที่ได้รับ
      document.getElementById('fighter1-port').textContent = status.fighterPort1 || 'ไม่ระบุ';
      document.getElementById('fighter2-port').textContent = status.fighterPort2 || 'ไม่ระบุ';

      const status1 = document.getElementById('fighter1-status');
      status1.textContent = status.fighterPort1 ? 'เชื่อมต่อแล้ว' : 'ยังไม่เชื่อมต่อ';
      status1.classList.toggle('connected', !!status.fighterPort1);
      status1.classList.toggle('disconnected', !status.fighterPort1);

      const status2 = document.getElementById('fighter2-status');
      status2.textContent = status.fighterPort2 ? 'เชื่อมต่อแล้ว' : 'ยังไม่เชื่อมต่อ';
      status2.classList.toggle('connected', !!status.fighterPort2);
      status2.classList.toggle('disconnected', !status.fighterPort2);

document.getElementById('fighter1-header').textContent = `ข้อมูล Real-time <%= fighter1.name %> (${status.fighterPort1 || 'ไม่ระบุ'})`;
document.getElementById('fighter2-header').textContent = `ข้อมูล Real-time <%= fighter2.name %> (${status.fighterPort2 || 'ไม่ระบุ'})`;
    });

    socket.on('COM_PORT_1_DATA', (data) => {
      console.log('📥 COM_PORT_1_DATA:', data);
      const currentTimeSec = startTime ? Math.floor((Date.now() - startTime) / 1000) : 0;
      Object.keys(data).forEach(pos => {
        addRealtimeData('นักชก1', pos, data[pos], currentTimeSec);
        addTableRow('fighter1Table', pos, data[pos], currentTimeSec);
      });
    });

    socket.on('COM_PORT_2_DATA', (data) => {
      console.log('📥 COM_PORT_2_DATA:', data);
      const currentTimeSec = startTime ? Math.floor((Date.now() - startTime) / 1000) : 0;
      Object.keys(data).forEach(pos => {
        addRealtimeData('นักชก2', pos, data[pos], currentTimeSec);
        addTableRow('fighter2Table', pos, data[pos], currentTimeSec);
      });
    });

    socket.on('connectionError', (message) => {
      console.error('🚫 Connection error:', message);
      alert(message);
    });

    function swapPorts() {
      socket.emit('swapCOMPorts');
      alert('กำลังสลับพอร์ตนักชก...');
    }

    function addRealtimeData(label, position, value, timeHitSec = 0) {
      console.log(`💾 addRealtimeData: label=${label}, position=${position}, value=${value}, timeHitSec=${timeHitSec}`);
      realtimeData.push({
        label,
        position,
        value: `${value}|${timeHitSec}`,
        fighterdetail: `${label} ${value} ${position}`
      });
    }

    function addTableRow(tableId, position, value, timeSec) {
      const tbody = document.querySelector(`#${tableId} tbody`);
      const tr = document.createElement('tr');
      const elapsedStr = startTime 
        ? `${Math.floor(timeSec / 60)}:${(timeSec % 60).toString().padStart(2, '0')}`
        : '0:00';
      tr.innerHTML = `
        <td>${elapsedStr}</td>
        <td>${position}</td>
        <td>${value}</td>
      `;
      tbody.prepend(tr);
      while (tbody.children.length > 20) {
        tbody.removeChild(tbody.lastChild);
      }
      tbody.parentElement.scrollTop = 0;
    }

    function startRecording() {
      startTime = Date.now();
      console.log('🔄 startRecording: startTime set to', startTime);
      recordedChunks1 = [];
      recordedChunks2 = [];
      realtimeData = [];

      navigator.mediaDevices.enumerateDevices()
        .then(devices => {
          const videoInputs = devices.filter(device => device.kind === 'videoinput');
          console.log('📹 Video inputs:', videoInputs);
          const promises = [];
          if (videoInputs.length >= 1) {
            promises.push(navigator.mediaDevices.getUserMedia({ video: { deviceId: videoInputs[0].deviceId }, audio: true }));
          } else {
            console.warn('⚠️ ไม่พบกล้องตัวที่ 1');
          }
          if (videoInputs.length >= 2) {
            promises.push(navigator.mediaDevices.getUserMedia({ video: { deviceId: videoInputs[1].deviceId }, audio: true }));
          } else {
            console.warn('⚠️ ไม่พบกล้องตัวที่ 2');
          }
          return Promise.allSettled(promises);
        })
        .then(results => {
          const cam1 = document.getElementById('cam1');
          const cam2 = document.getElementById('cam2');
          let stream1 = null, stream2 = null;

          if (results[0]?.status === 'fulfilled') {
            stream1 = results[0].value;
            cam1.srcObject = stream1;
            cam1.play().catch(err => console.error('Error playing cam1:', err));
            mediaRecorder1 = new MediaRecorder(stream1);
            mediaRecorder1.ondataavailable = e => {
              if (e.data.size > 0) recordedChunks1.push(e.data);
            };
            mediaRecorder1.start();
          } else {
            console.error('❌ ล้มเหลวในการเปิดกล้องตัวที่ 1:', results[0]?.reason);
            alert('ไม่สามารถเปิดกล้องตัวที่ 1 ได้: ' + results[0]?.reason?.message);
          }

          if (results[1]?.status === 'fulfilled') {
            stream2 = results[1].value;
            cam2.srcObject = stream2;
            cam2.play().catch(err => console.error('Error playing cam2:', err));
            mediaRecorder2 = new MediaRecorder(stream2);
            mediaRecorder2.ondataavailable = e => {
              if (e.data.size > 0) recordedChunks2.push(e.data);
            };
            mediaRecorder2.start();
          } else {
            console.warn('⚠️ ไม่สามารถเปิดกล้องตัวที่ 2 ได้:', results[1]?.reason);
            alert('ไม่สามารถเปิดกล้องตัวที่ 2 ได้: ' + (results[1]?.reason?.message || 'ไม่พบกล้อง'));
          }

          if (stream1 || stream2) {
            document.getElementById('stopBtn').disabled = false;
            alert('เริ่มบันทึกกล้อง' + (stream1 && stream2 ? 'ทั้งสองตัว' : stream1 ? 'ตัวที่ 1' : 'ตัวที่ 2') + 'แล้ว!');
          } else {
            throw new Error('ไม่สามารถเปิดกล้องใดๆ ได้');
          }
        })
        .catch(err => {
          console.error('เกิดข้อผิดพลาด:', err);
          alert('ไม่สามารถเปิดกล้องได้: ' + err.message);
        });
    }

    async function stopRecording() {
      const stopPromises = [];
      let blob1 = null, blob2 = null;
      // สำหรับ mediaRecorder1
      if (mediaRecorder1?.state === 'recording' || mediaRecorder1?.state === 'paused') {
        stopPromises.push(
          new Promise(resolve => {
            mediaRecorder1.onstop = () => resolve(new Blob(recordedChunks1, { type: 'video/webm' }));
            mediaRecorder1.stop();
          })
        );
      }

      // สำหรับ mediaRecorder2 
      if (mediaRecorder2?.state === 'recording' || mediaRecorder2?.state === 'paused') {
        stopPromises.push(
          new Promise(resolve => {
            mediaRecorder2.onstop = () => resolve(new Blob(recordedChunks2, { type: 'video/webm' }));
            mediaRecorder2.stop();
          })
        );
      }

      try {
        const blobs = await Promise.all(stopPromises);
        if (blobs.length > 0 && blobs[0] && blobs[0].size > 0) blob1 = blobs[0];
        if (blobs.length > 1 && blobs[1] && blobs[1].size > 0) blob2 = blobs[blobs.length - 1];

        const uploadPromises = [];
        let clipUrl1 = '', clipUrl2 = '';
        if (blob1) {
          const formData1 = new FormData();
          formData1.append('video', blob1, 'fight_cam1.webm');
          uploadPromises.push(fetch('/upload-video', { method: 'POST', body: formData1 }).then(res => res.json()));
        }
        if (blob2) {
          const formData2 = new FormData();
          formData2.append('video', blob2, 'fight_cam2.webm');
          uploadPromises.push(fetch('/upload-video', { method: 'POST', body: formData2 }).then(res => res.json()));
        }

        const uploadResults = await Promise.all(uploadPromises);
        if (blob1 && uploadResults[0]?.success) clipUrl1 = uploadResults[0].url;
        if (blob2 && uploadResults[1]?.success) clipUrl2 = uploadResults[1].url;

        const endTime = Date.now();
        const durationMs = endTime - startTime;
        const totalSeconds = Math.floor(durationMs / 1000);
        const fightDuration = `${Math.floor(totalSeconds / 60)}:${(totalSeconds % 60).toString().padStart(2, '0')}`;
        const saveRes = await fetch('/datafight/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            schedulefight_id: "<%= schedulefightId %>",
            clip_url: clipUrl1,
            clip_url2: clipUrl2,
            time: fightDuration,
            data: realtimeData,
            round: roundNumber
          })
        });
        const saveData = await saveRes.json();
        if (!saveData.success) throw new Error('Save to DB failed');
        roundsData.push({
          round: roundNumber,
          fightDuration,
          videoUrl: clipUrl1,
          videoUrl2: clipUrl2,
          data: [...realtimeData]
        });
        roundNumber++;
        
        alert('บันทึกข้อมูลเรียบร้อยแล้ว' + (clipUrl1 || clipUrl2 ? ' (รวมวิดีโอ)' : ' (ไม่มีวิดีโอ)'));
        document.getElementById('stopBtn').disabled = true;

        // หยุด stream กล้อง
        const cam1 = document.getElementById('cam1');
        const cam2 = document.getElementById('cam2');
        if (cam1.srcObject) {
          cam1.srcObject.getTracks().forEach(track => track.stop());
          cam1.srcObject = null;
        }
        if (cam2.srcObject) {
          cam2.srcObject.getTracks().forEach(track => track.stop());
          cam2.srcObject = null;
        }
        window.location.reload();
      } catch (error) {
        console.error('เกิดข้อผิดพลาด:', error);
        alert('เกิดข้อผิดพลาด: ' + error.message);
      }
      
    }

    function testCameras() {
      navigator.mediaDevices.enumerateDevices()
        .then(devices => {
          const videoInputs = devices.filter(device => device.kind === 'videoinput');
          console.log('📹 Video inputs for test:', videoInputs);
          const promises = [];
          if (videoInputs.length >= 1) {
            promises.push(navigator.mediaDevices.getUserMedia({ video: { deviceId: videoInputs[0].deviceId }, audio: false }));
          }
          if (videoInputs.length >= 2) {
            promises.push(navigator.mediaDevices.getUserMedia({ video: { deviceId: videoInputs[1].deviceId }, audio: false }));
          }
          return Promise.allSettled(promises);
        })
        .then(results => {
          const modal = document.getElementById('cameraTestModal');
          const testCam1 = document.getElementById('testCam1');
          const testCam2 = document.getElementById('testCam2');

          if (results[0]?.status === 'fulfilled') {
            testStream1 = results[0].value;
            testCam1.srcObject = testStream1;
            testCam1.style.display = 'block';
            testCam1.play().catch(err => console.error('Error playing testCam1:', err));
          } else {
            console.warn('⚠️ ไม่สามารถเปิดกล้องตัวที่ 1 ได้:', results[0]?.reason);
            testCam1.style.display = 'none';
            alert('ไม่สามารถเปิดกล้องตัวที่ 1 ได้: ' + (results[0]?.reason?.message || 'ไม่พบกล้อง'));
          }

          if (results[1]?.status === 'fulfilled') {
            testStream2 = results[1].value;
            testCam2.srcObject = testStream2;
            testCam2.style.display = 'block';
            testCam2.play().catch(err => console.error('Error playing testCam2:', err));
          } else {
            console.warn('⚠️ ไม่สามารถเปิดกล้องตัวที่ 2 ได้:', results[1]?.reason);
            testCam2.style.display = 'none';
            alert('ไม่สามารถเปิดกล้องตัวที่ 2 ได้: ' + (results[1]?.reason?.message || 'ไม่พบกล้อง'));
          }

          if (testStream1 || testStream2) {
            modal.style.display = 'flex';
          } else {
            throw new Error('ไม่สามารถเปิดกล้องใดๆ ได้');
          }
        })
        .catch(err => {
          console.error('เกิดข้อผิดพลาดในการทดสอบกล้อง:', err);
          alert('ไม่สามารถทดสอบกล้องได้: ' + err.message);
        });
    }

    function closeCameraTestModal() {
      const modal = document.getElementById('cameraTestModal');
      const testCam1 = document.getElementById('testCam1');
      const testCam2 = document.getElementById('testCam2');

      if (testStream1) {
        testStream1.getTracks().forEach(track => track.stop());
        testStream1 = null;
      }
      if (testStream2) {
        testStream2.getTracks().forEach(track => track.stop());
        testStream2 = null;
      }
      testCam1.srcObject = null;
      testCam2.srcObject = null;
      testCam1.style.display = 'none';
      testCam2.style.display = 'none';
      modal.style.display = 'none';
    }

function openClipModal(url1, url2, timehit, timestamps, round) {
  console.log('openClipModal called!', { url1, url2, timehit, round, timestampsLength: timestamps?.length });
  const decodedUrl1 = url1 ? decodeURIComponent(url1) : '';
  const decodedUrl2 = url2 ? decodeURIComponent(url2) : '';
  const decodedTimehit = decodeURIComponent(timehit || '00:00:00');

  const modal = document.getElementById('clipModal');
  const video1 = document.getElementById('clipVideo1');
  const video2 = document.getElementById('clipVideo2');
  const timestampContainer = document.getElementById('timestampButtons');

  modal.style.display = 'flex';
  video1.style.display = decodedUrl1 ? 'block' : 'none';
  video2.style.display = decodedUrl2 ? 'block' : 'none';

  video1.pause();
  video2.pause();
  video1.removeAttribute('src');
  video2.removeAttribute('src');

  if (decodedUrl1) video1.src = decodedUrl1;
  if (decodedUrl2) video2.src = decodedUrl2;

  video1.load();
  video2.load();

  // แยก timestamps เป็น 2 กลุ่มตามนักชก
  const fighter1Timestamps = timestamps.filter(ts => 
    ts.detail.includes('นักชก1') || ts.detail.includes('<%= fighter1.name %>')
  );
  const fighter2Timestamps = timestamps.filter(ts => 
    ts.detail.includes('นักชก2') || ts.detail.includes('<%= fighter2.name %>')
  );

  // สร้าง HTML แยก 2 ฝั่งสวยงาม
  let html = '<div class="timestamp-section">';
  
  // ฝั่งนักชก 1
  html += '<div class="timestamp-group">';
  html += `<h4><%= fighter1.name %></h4>`;
  if (fighter1Timestamps.length === 0) {
    html += '<p style="text-align:center; color:#888;">ไม่มีเหตุการณ์</p>';
  } else {
    fighter1Timestamps.forEach(ts => {
      html += `<button onclick="seekTo('${ts.timehit}')">${ts.timehit} (${ts.detail})</button>`;
    });
  }
  html += '</div>';

  // ฝั่งนักชก 2
  html += '<div class="timestamp-group">';
  html += `<h4><%= fighter2.name %></h4>`;
  if (fighter2Timestamps.length === 0) {
    html += '<p style="text-align:center; color:#888;">ไม่มีเหตุการณ์</p>';
  } else {
    fighter2Timestamps.forEach(ts => {
      html += `<button onclick="seekTo('${ts.timehit}')">${ts.timehit} (${ts.detail})</button>`;
    });
  }
  html += '</div>';

  html += '</div>';

  timestampContainer.innerHTML = html;

  // ตั้งเวลาเริ่มต้นเหมือนเดิม
  let seconds = hhmmssToSeconds(decodedTimehit) - 2;
  seconds = Math.max(0, seconds);

  const waitForVideo = (video) => new Promise(resolve => {
    if (!video.src) return resolve();
    video.onloadedmetadata = () => {
      video.currentTime = seconds;
      video.onseeked = () => resolve();
    };
    video.onerror = () => resolve();
  });

  Promise.all([waitForVideo(video1), waitForVideo(video2)])
    .then(() => {
      if (decodedUrl1) video1.play().catch(err => console.error(err));
      if (decodedUrl2) video2.play().catch(err => console.error(err));
    });
}

// ฟังก์ชันใหม่สำหรับ seek วิดีโอเมื่อกดปุ่ม timestamp
function seekTo(timehit) {
  const seconds = hhmmssToSeconds(timehit) - 2;
  const seekSec = Math.max(0, seconds);
  const video1 = document.getElementById('clipVideo1');
  const video2 = document.getElementById('clipVideo2');
  
  if (video1.src) {
    video1.currentTime = seekSec;
    video1.play().catch(e => console.error(e));
  }
  if (video2.src) {
    video2.currentTime = seekSec;
    video2.play().catch(e => console.error(e));
  }
}

    function closeClipModal() {
      const modal = document.getElementById('clipModal');
      const video1 = document.getElementById('clipVideo1');
      const video2 = document.getElementById('clipVideo2');
      video1.pause();
      video2.pause();
      video1.removeAttribute('src');
      video2.removeAttribute('src');
      video1.load();
      video2.load();
      modal.style.display = 'none';
    }

    function hhmmssToSeconds(hhmmss) {
      const parts = hhmmss.split(':').map(Number);
      return parts.length === 3 ? parts[0] * 3600 + parts[1] * 60 + parts[2] : 0;
    }

    function formatSeconds(sec) {
      const h = Math.floor(sec / 3600);
      const m = Math.floor((sec % 3600) / 60);
      const s = Math.floor(sec % 60);
      return [h, m, s].map(n => String(n).padStart(2, '0')).join(':');
    }

    // สรุปผลการแข่งขัน
    document.getElementById('btnSummary').addEventListener('click', () => {
      document.getElementById('summaryContent').innerHTML = 'กำลังโหลดข้อมูล...';
