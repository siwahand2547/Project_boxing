    function swapPorts() {
    // ถามยืนยันก่อน
    if (!confirm("คุณแน่ใจหรือไม่ที่จะสลับพอร์ตนักชก?\n\nการสลับจะทำให้ข้อมูลเรียลไทม์และตารางเปลี่ยนฝั่งทันที")) {
      return; // ถ้ากดยกเลิก → ไม่ทำอะไร
    }

    // ถ้ากดตกลง → ส่ง event ไป server
    socket.emit('swapCOMPorts');
    alert('สลับพอร์ตนักชกเรียบร้อย');
  }

  async function openCameraSelector() {
  const modal = document.getElementById('cameraSelectorModal');
  const listDiv = document.getElementById('cameraList');

  listDiv.innerHTML = '<p>กำลังโหลดรายการกล้อง...</p>';

  try {
    // ขออนุญาตก่อนเพื่อให้เห็น label จริง
    await navigator.mediaDevices.getUserMedia({ video: true }).catch(() => {});
    const devices = await navigator.mediaDevices.enumerateDevices();
    const videoInputs = devices.filter(d => d.kind === 'videoinput');

    if (videoInputs.length === 0) {
      listDiv.innerHTML = '<p style="color:red;">ไม่พบกล้องใด ๆ</p>';
      return;
    }

    let html = '';
    ['cam1', 'cam2', 'cam3', 'cam4'].forEach((camId, index) => {
      html += `<div style="margin:15px 0;">
        <label><strong>ช่อง ${index+1} (${camId})</strong></label><br>
        <select id="select-${camId}">
          <option value="">-- ไม่เลือก / ใช้ค่าเริ่มต้น --</option>
          ${videoInputs.map(dev => 
            `<option value="${dev.deviceId}" ${selectedDeviceIds[camId] === dev.deviceId ? 'selected' : ''}>
              ${dev.label || `กล้อง ${index+1} (${dev.deviceId.slice(0,8)}...`}
            </option>`
          ).join('')}
        </select>
      </div>`;
    });

    listDiv.innerHTML = html;
    modal.style.display = 'flex';

  } catch (err) {
    listDiv.innerHTML = `<p style="color:red;">เกิดข้อผิดพลาด: ${err.message}</p>`;
  }
}

function closeCameraSelector() {
  document.getElementById('cameraSelectorModal').style.display = 'none';
}

function saveCameraSelection() {
  ['cam1','cam2','cam3','cam4'].forEach(cam => {
    const select = document.getElementById(`select-${cam}`);
    selectedDeviceIds[cam] = select.value || null;
  });
  alert('บันทึกการเลือกกล้องเรียบร้อยแล้ว');
  closeCameraSelector();
}

