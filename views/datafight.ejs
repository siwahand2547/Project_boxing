        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ schedulefightId: <%= schedulefightId %> })
      })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            let html = '<table style="width:100%; border-collapse:collapse; background:#222; border-radius:6px;">';
