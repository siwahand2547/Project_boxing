              html += `<td style="border:1px solid #444; padding:8px;">${f[fids[0]]}</td>`;
              html += `<td style="border:1px solid #444; padding:8px;">${s1.body}</td>`;
              html += `<td style="border:1px solid #444; padding:8px;">${s1.head}</td>`;
              html += `<td style="border:1px solid #444; padding:8px;">${s1.fall}</td>`;
              html += `<td style="border:1px solid #444; padding:8px;">${s1.total}</td>`;
              html += `<td rowspan="2" style="border:1px solid #444; padding:8px;">${winnerName}</td></tr>`;
              html += `<tr><td style="border:1px solid #444; padding:8px;">${f[fids[1]]}</td>`;
              html += `<td style="border:1px solid #444; padding:8px;">${s2.body}</td>`;
              html += `<td style="border:1px solid #444; padding:8px;">${s2.head}</td>`;
              html += `<td style="border:1px solid #444; padding:8px;">${s2.fall}</td>`;
              html += `<td style="border:1px solid #444; padding:8px;">${s2.total}</td></tr>`;
            });
            html += '</tbody></table>';
            const win1 = data.summaryByRound.filter(r => r.winnerId === fids[0]).length;
            const win2 = data.summaryByRound.filter(r => r.winnerId === fids[1]).length;
            const finalWinnerText = data.overallWinnerId ? `🏆 <strong>ผู้ชนะรวม: ${f[data.overallWinnerId]}</strong>` :
                                   `🤝 <strong>ผลการแข่งขันเสมอ</strong>`;
            html += `<div style="margin-top:20px; font-size:1.2em; text-align:center;">${finalWinnerText}</div>`;
            document.getElementById('summaryContent').innerHTML = html;
          } else {
            document.getElementById('summaryContent').innerHTML = `<p style="color:#ff4444;">เกิดข้อผิดพลาด: ${data.message}</p>`;
          }
          document.getElementById('summaryModal').style.display = 'flex';
        })
        .catch(err => {
          document.getElementById('summaryContent').innerHTML = `<p style="color:#ff4444;">เกิดข้อผิดพลาด: ${err.message}</p>`;
        });
    });

    function swapPorts() {
    // ถามยืนยันก่อน
    if (!confirm("คุณแน่ใจหรือไม่ที่จะสลับพอร์ตนักชก?\n\nการสลับจะทำให้ข้อมูลเรียลไทม์และตารางเปลี่ยนฝั่งทันที")) {
