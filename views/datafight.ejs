    async function startRecording() {
  if (startTime) {
    alert('กำลังบันทึกอยู่แล้ว! กรุณากด "จบการแข่งขัน" ก่อน');
    return;
  }

  if (!isPreloaded) {
    alert('กรุณากด "เตรียมกล้องล่วงหน้า" ก่อนเริ่มการแข่งขัน เพื่อให้เริ่มได้เร็ว');
    return;
  }

  startTime = Date.now();
  recordedChunks1 = [];
  recordedChunks2 = [];
  recordedChunks3 = [];
  recordedChunks4 = [];
  realtimeData = [];

  elapsedSeconds = 0;
  updateTimerDisplay();

  let cameraCount = 0;

  // ใช้ stream ที่ preload ไว้แล้ว
  stream1 = preloadedStreams.cam1;
  stream2 = preloadedStreams.cam2;
  stream3 = preloadedStreams.cam3;
  stream4 = preloadedStreams.cam4;

  // เริ่มบันทึกสำหรับแต่ละกล้องที่มี stream
  if (stream1 && stream1.active) {
    mediaRecorder1 = new MediaRecorder(stream1);
    mediaRecorder1.ondataavailable = e => {
      if (e.data.size > 0) recordedChunks1.push(e.data);
    };
    mediaRecorder1.start();
    cameraCount++;
  }

  if (stream2 && stream2.active) {
    mediaRecorder2 = new MediaRecorder(stream2);
    mediaRecorder2.ondataavailable = e => {
      if (e.data.size > 0) recordedChunks2.push(e.data);
    };
    mediaRecorder2.start();
    cameraCount++;
  }

  if (stream3 && stream3.active) {
    mediaRecorder3 = new MediaRecorder(stream3);
    mediaRecorder3.ondataavailable = e => {
      if (e.data.size > 0) recordedChunks3.push(e.data);
    };
    mediaRecorder3.start();
    cameraCount++;
  }

  if (stream4 && stream4.active) {
    mediaRecorder4 = new MediaRecorder(stream4);
    mediaRecorder4.ondataavailable = e => {
      if (e.data.size > 0) recordedChunks4.push(e.data);
    };
    mediaRecorder4.start();
    cameraCount++;
  }

  if (cameraCount === 0) {
    alert('ไม่มีกล้องที่พร้อมใช้งาน กรุณากด "เตรียมกล้องล่วงหน้า" อีกครั้ง');
    startTime = null;
    return;
  }

  if (!fightTimerInterval) {
  fightTimerInterval = setInterval(() => {
    if (!startTime) {  // ป้องกัน interval วิ่งต่อหลัง stop
      clearInterval(fightTimerInterval);
      fightTimerInterval = null;
      return;
    }

    elapsedSeconds++;
    updateTimerDisplay();

    if (elapsedSeconds >= MAX_ROUND_SECONDS) {
      console.log("หมดเวลา 3 นาที → เรียก auto stopRecording");
      stopRecording();
    }
  }, 1000);
}

  document.getElementById('stopBtn').disabled = false;
  alert(`เริ่มการแข่งขันเรียบร้อยแล้ว (ใช้กล้อง ${cameraCount} ตัวที่เตรียมไว้)`);
}
