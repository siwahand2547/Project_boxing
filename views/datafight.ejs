<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>เปรียบเทียบนักชก</title>
  <script src="/socket.io/socket.io.js"></script>
<style>
  :root {
  --bg: #f8f9fa;
  --card-bg: #ffffff;
  --text: #1f2937;
  --text-muted: #6b7280;
  --border: #e2e8f0;
  --table-border: #e5e7eb;
  --header-bg: #4b5563;          /* ปรับอ่อนลงจาก #374151 → เทาเข้มกลาง สวยงามขึ้น */
  --header-text: #ffffff;
  --accent: #3b82f6;
  --accent-hover: #2563eb;
  --danger: #ef4444;
  --danger-hover: #dc2626;
  --success: #10b981;
  --even-row: #f9fafb;
  --hover-row: #f1f5f9;
  --shadow: 0 4px 12px rgba(0, 0, 0, 0.05);
}
  body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    background: var(--bg);
    color: var(--text);
    margin: 0;
    padding: 20px;
    overflow-x: hidden;
  }

  h1, h2, h3 {
    color: #111827;
    border-left: 5px solid var(--accent);
    padding-left: 15px;
    margin-bottom: 20px;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
  }

  table.fighter-info, table.realtime-table, table.fight-rounds {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
    background: var(--card-bg);
    box-shadow: var(--shadow);
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--border);
  }

table.fighter-info th, 
table.realtime-table th, 
table.fight-rounds th,
.fight-table th {                  /* เพิ่ม .fight-table th เพื่อครอบคลุมหน้าอื่นด้วย */
  background: var(--header-bg);
  color: var(--header-text);
  padding: 12px;
  text-align: center;
  font-weight: 600;
  font-size: 0.95rem;
  text-transform: uppercase;
  letter-spacing: 0.4px;
  border-bottom: 2px solid #6b7280;  /* เส้นใต้อ่อนลง ให้ดูนุ่มนวล */
}

  table.fighter-info td, table.realtime-table td, table.fight-rounds td {
    padding: 12px;
    text-align: center;
    border-top: 1px solid var(--table-border);
    color: var(--text);
  }

  .fighter-info-container {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 20px;
  }

  .fighter-info {
    flex: 1 1 45%;
    min-width: 300px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  img {
    width: 100px;
    height: 100px;
    object-fit: cover;
    border-radius: 6px;
    box-shadow: 0 0 8px rgba(0,0,0,0.08);
  }

  .realtime-container {
    flex: 1 1 45%;
    min-width: 300px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 15px;
    box-sizing: border-box;
    max-height: 300px;
    overflow-y: auto;
    margin-bottom: 20px;
    box-shadow: var(--shadow);
  }

  .realtime-container.fighter2 {
    border-left: 4px solid #6b7280;
  }

  .realtime-container h2 {
    color: #111827;
    margin: 0 0 10px 0;
    font-size: 1.2em;
    font-weight: 600;
  }

  .watch-btn {
    background: var(--accent);
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .watch-btn:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
  }

  button {
    font-size: 14px;
    margin: 5px;
    border: none;
    background: #e5e7eb;
    color: #374151;
    padding: 10px 16px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  button:hover {
    background: #d1d5db;
  }

  button:disabled {
    background: #e5e7eb;
    color: #9ca3af;
    cursor: not-allowed;
    opacity: 0.7;
  }

  #clipModal, #videoModal, #summaryModal, #cameraTestModal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--modal-bg);
    z-index: 1000;
    justify-content: center;
    align-items: center;
    flex-direction: column;
  }

  #clipModal .modal-content, #videoModal .modal-content, #summaryModal .modal-content, #cameraTestModal .modal-content {
    background: var(--card-bg);
    padding: 20px;
    border-radius: 12px;
    max-width: 90%;
    max-height: 90vh;
    overflow: auto;
    position: relative;
    box-shadow: 0 20px 60px rgba(0,0,0,0.25);
    border: 1px solid var(--border);
  }

  #clipModal video {
    max-width: 45%;
    max-height: 70vh;
    border-radius: 8px;
    background: #000;
    box-shadow: 0 0 15px rgba(0,0,0,0.15);
    margin: 10px;
  }

  #videoModal video {
    max-width: 800px;
    max-height: 80vh;
    border-radius: 8px;
  }

  #clipModal h3 {
    color: #111827;
    margin: 10px 0 5px;
    font-size: 1.2em;
  }

  #timestampButtons button {
    background: var(--accent);
    color: white;
    border: none;
    padding: 8px 12px;
    margin: 5px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  #timestampButtons button:hover {
    background: var(--accent-hover);
  }

  #timestampButtons button.active {
    background: var(--success);
  }

  .modal-close {
    position: absolute;
    top: 15px;
    right: 15px;
    color: #6b7280;
    font-size: 28px;
    cursor: pointer;
    transition: color 0.2s;
  }

  .modal-close:hover {
    color: var(--accent);
  }

  #summaryModal .modal-content {
    max-width: 800px;
    width: 90%;
  }

  #summaryContent {
    max-height: 60vh;
    overflow-y: auto;
    padding: 15px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: #ffffff;
  }

  #summaryContent table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 15px;
  }

  #summaryContent th, #summaryContent td {
    padding: 8px;
    text-align: center;
    border: 1px solid var(--table-border);
  }

  #summaryContent th {
    background: var(--header-bg);
    color: var(--header-text);
    font-weight: 600;
  }

  #summaryContent tbody tr:nth-child(even) {
    background: var(--even-row);
  }

  .connected { color: var(--success); font-weight: bold; }
  .disconnected { color: var(--danger); font-weight: bold; }

  /* ส่วน layout ใหม่ - ปรับสีให้เข้ากัน */
  .main-flex-layout {
    display: flex;
    flex-wrap: wrap;
    gap: 25px;
    margin-top: 20px;
    align-items: flex-start;
  }

  .left-main-content {
    flex: 3 1 750px;
    min-width: 0;
  }

  .right-cameras-sidebar {
    flex: 1 1 360px;
    max-width: 380px;
    position: sticky;
    top: 30px;
    align-self: flex-start;
  }

  .camera-box {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 15px;
    box-shadow: var(--shadow);
  }

  .camera-box h3 {
    margin: 0 0 12px;
    color: var(--text);
    text-align: center;
    font-size: 1.1em;
    font-weight: 600;
  }

  .camera-item {
    margin-bottom: 15px;
    text-align: center;
  }

  .camera-item small {
    display: block;
    color: var(--text-muted);
    margin-bottom: 6px;
  }

  .camera-item video {
    width: 100%;
    height: auto;
    max-height: 240px;
    background: #000;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }

  @media (max-width: 1100px) {
    .main-flex-layout {
      flex-direction: column;
    }
    .right-cameras-sidebar {
      position: static;
      max-width: 500px;
      margin: 0 auto 30px;
    }
  }

  @media (max-width: 768px) {
    .fighter-info, .realtime-container {
      flex: 1 1 100%;
    }
    #clipModal video {
      max-width: 90%;
    }
    #summaryModal .modal-content {
      max-width: 95%;
    }
  }

  #cameraTestModal .modal-content {
    background: var(--card-bg);
  }

  #cameraTestModal video {
    max-width: 45%;
    max-height: 70vh;
    border-radius: 8px;
    background: #000;
    box-shadow: 0 0 15px rgba(0,0,0,0.15);
    margin: 10px;
  }

  .timestamp-section {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 20px;
  }

  .timestamp-group {
    flex: 1 1 45%;
    min-width: 280px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 15px;
    box-shadow: var(--shadow);
  }

  .timestamp-group h4 {
    text-align: center;
    margin: 0 0 12px 0;
    color: var(--text);
    font-size: 1.1em;
    font-weight: 600;
  }

  .timestamp-group button {
    width: 100%;
    margin: 6px 0;
    padding: 10px;
    background: var(--accent);
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .timestamp-group button:hover {
    background: var(--accent-hover);
  }

  .timestamp-group button.active {
    background: var(--success);
    transform: scale(1.03);
  }

  #summaryContent table tbody tr:nth-child(even) {
  background: var(--even-row); /* #f9fafb */
}

  #summaryContent table td, #summaryContent table th {
    padding: 10px 12px;
    text-align: center;
    border: 1px solid var(--table-border);
  }
</style>
</head>
<body>

  <div class="container">

    <!-- Modal เดิมทั้งหมด (เหมือนเดิม 100%) -->
    <div id="cameraTestModal">
      <div class="modal-content">
        <span class="modal-close" onclick="closeCameraTestModal()">&times;</span>
        <h2>ทดสอบกล้อง</h2>
        <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
          <video id="testCam1" autoplay playsinline style="display: none;"></video>
          <video id="testCam2" autoplay playsinline style="display: none;"></video>
        </div>
        <button onclick="closeCameraTestModal()">ปิด</button>
      </div>
    </div>

    <div id="clipModal">
      <div class="modal-content">
        <span class="modal-close" onclick="closeClipModal()">&times;</span>
        <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
          <div style="text-align: center;">
            <h3>กล้อง 1</h3>
            <video id="clipVideo1" muted preload="auto" controls style="display: none;"></video>
          </div>
          <div style="text-align: center;">
            <h3>กล้อง 2</h3>
            <video id="clipVideo2" muted preload="auto" controls style="display: none;"></video>
          </div>
          <div style="text-align: center;">
            <h3>กล้อง 3</h3>
            <video id="clipVideo3" muted preload="auto" controls style="display: none;"></video>
          </div>
          <div style="text-align: center;">
            <h3>กล้อง 4</h3>
            <video id="clipVideo4" muted preload="auto" controls style="display: none;"></video>
          </div>
        </div>
        <div id="timestampButtons" style="margin-top: 15px; text-align: center;"></div>
      </div>
    </div>

    <div id="summaryModal">
      <div class="modal-content">
        <span class="modal-close" onclick="document.getElementById('summaryModal').style.display='none'">&times;</span>
        <h2>สรุปผลการแข่งขัน</h2>
        <div id="summaryContent">กำลังโหลดข้อมูล...</div>
        <button onclick="document.getElementById('summaryModal').style.display='none'" style="align-self: flex-end;">ปิด</button>
      </div>
    </div>

    <%- include('partials/navbar') %>

    <div class="main-flex-layout">

      <!-- ฝั่งซ้าย: ข้อมูลหลักทั้งหมด (เหมือนเดิม) -->
      <div class="left-main-content">

        <h1>เปรียบเทียบนักชก (ID: <%= schedulefightId %>)</h1>

        <div class="fighter-info-container">
          <div class="fighter-info">
            <table class="fighter-info">
              <thead><tr><th>ชื่อ</th><th>ค่าย</th><th>รุ่นน้ำหนัก</th><th>ภาพ</th></tr></thead>
              <tbody>
                <tr>
                  <td><%= fighter1.name %></td>
                  <td><%= fighter1.camp %></td>
                  <td><%= fighter1.weight_class %></td>
                  <td><img src="<%= fighter1.photo || '/uploads/default.jpg' %>" alt="fighter1"></td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="fighter-info">
            <table class="fighter-info">
              <thead><tr><th>ชื่อ</th><th>ค่าย</th><th>รุ่นน้ำหนัก</th><th>ภาพ</th></tr></thead>
              <tbody>
                <tr>
                  <td><%= fighter2.name %></td>
                  <td><%= fighter2.camp %></td>
                  <td><%= fighter2.weight_class %></td>
                  <td><img src="<%= fighter2.photo || '/uploads/default.jpg' %>" alt="fighter2"></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <p>
          สถานะพอร์ต COM:<br />
          ➤ <span id="fighter1-port">กำลังโหลด...</span>: <span id="fighter1-status" class="disconnected">ยังไม่เชื่อมต่อ</span><br />
          ➤ <span id="fighter2-port">กำลังโหลด...</span>: <span id="fighter2-status" class="disconnected">ยังไม่เชื่อมต่อ</span>
        </p>

        <div class="fighter-info-container">
          <div class="realtime-container" id="realtime1">
            <h2 id="fighter1-header">ข้อมูล Real-time <%= fighter1.name %></h2>
            <table class="realtime-table" id="fighter1Table">
              <thead><tr><th>เวลา</th><th>ตำแหน่ง</th><th>ข้อมูล (N)</th></tr></thead>
              <tbody></tbody>
            </table>
          </div>
          <div class="realtime-container fighter2" id="realtime2">
            <h2 id="fighter2-header">ข้อมูล Real-time <%= fighter2.name %></h2>
            <table class="realtime-table" id="fighter2Table">
              <thead><tr><th>เวลา</th><th>ตำแหน่ง</th><th>ข้อมูล (N)</th></tr></thead>
              <tbody></tbody>
            </table>
          </div>
        </div>

        <div style="text-align: center; margin: 20px 0;">
          <button onclick="startRecording()" id="startBtn" disabled>🎥 เริ่มการแข่งขัน (รอเชื่อมต่อ COM)</button>
          <button onclick="stopRecording()" id="stopBtn" disabled>⛔ จบการแข่งขัน</button>
          <button id="btnSummary">📊 สรุปผลการแข่งขัน</button>
          <button onclick="swapPorts()" id="swapBtn" disabled>🔄 สลับพอร์ตนักชก (รอเชื่อมต่อ COM)</button>
          <button onclick="testCameras()">📸 ทดสอบกล้อง</button>
          <button onclick="openCameraSelector()" id="selectCamBtn" disabled>🎛️ เลือกกล้องก่อนบันทึก</button>
        </div>

        <h2>ข้อมูลการแข่งขันย้อนหลัง</h2>
        <div id="fightRoundsContainer">
          <% Object.keys(fightDataGrouped).forEach(round => { %>
            <table class="fight-rounds">
              <thead>
                <tr><th colspan="5">ยกที่ <%= round %></th></tr>
                <tr><th>เวลาที่โดน</th><th>ระยะเวลา</th><th>นักชก</th><th>รายละเอียด</th><th>คลิปกล้อง</th></tr>
              </thead>
              <tbody>
                <% fightDataGrouped[round].forEach(item => { 
                  const fighterName = fighterIdNameMap[item.fighterid] || item.fighterid;
                  const timestamps = fightDataGrouped[round].map(t => ({ timehit: t.timehit, detail: t.fighterdetail }));
                %>
                  <tr>
                    <td><%= item.timehit %></td>
                    <td><%= item.time %></td>
                    <td><%= fighterName %></td>
                    <td><%= item.fighterdetail %></td>
                    <td>
  <%
    // ตรวจสอบว่ามีคลิปกี่ตัว (เพื่อแสดงข้อความปุ่มให้สวย)
    const clips = [
      item.clipdetail,
      item.clipdetail2,
      item.clipdetail3,
      item.clipdetail4
    ].filter(Boolean); // กรองเฉพาะค่าที่ไม่ว่าง/null/undefined
    const clipCount = clips.length;
  %>

  <% if (clipCount > 0) { %>
    <button class="watch-btn"
            onclick='openClipModal(
              "<%= encodeURIComponent(item.clipdetail  || "") %>",
              "<%= encodeURIComponent(item.clipdetail2 || "") %>",
              "<%= encodeURIComponent(item.clipdetail3 || "") %>",
              "<%= encodeURIComponent(item.clipdetail4 || "") %>",
              "<%= encodeURIComponent(item.timehit) %>",
              <%= JSON.stringify(timestamps) %>,
              "<%= round %>"
            )'>
      ดูคลิป <%= clipCount %> มุม
    </button>
  <% } else { %>
    ไม่มีคลิป
  <% } %>
</td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% }) %>
        </div>

      </div>

      <!-- ฝั่งขวา: กล้องเรียลไทม์ (sticky) -->
      <div class="right-cameras-sidebar">
        <div class="camera-box">
          <h3>มุมมองเรียลไทม์</h3>
          <div class="camera-item">
            <small>กล้อง 1</small>
            <video id="cam1" autoplay playsinline></video>
          </div>
          <div class="camera-item">
            <small>กล้อง 2</small>
            <video id="cam2" autoplay playsinline></video>
          </div>
          <div class="camera-item">
            <small>กล้อง 3</small>
            <video id="cam3" autoplay playsinline></video>
          </div>
          <div class="camera-item">
            <small>กล้อง 4</small>
            <video id="cam4" autoplay playsinline></video>
          </div>
        </div>
      </div>

    </div>

  </div>

  <script>
    const socket = io();
    let mediaRecorder1, mediaRecorder2, ediaRecorder3, mediaRecorder4;
    let recordedChunks1 = [], recordedChunks2 = [], recordedChunks3 = [], recordedChunks4 = [];
    let startTime = null;
    let realtimeData = [];
    let roundsData = [];
    let roundNumber = <%= typeof roundNumberStart !== 'undefined' ? roundNumberStart : 1 %>;
    let testStream1 = null, testStream2 = null;

    let stream1 = null;
    let stream2 = null;
    let stream3 = null;
    let stream4 = null;


    socket.on('connect', () => {
      console.log('Socket.IO connected');
      socket.emit('requestConnectionStatus');
    });

    socket.on('connectionStatus', (status) => {
      console.log('📡 Received connection status:', status); // เพิ่ม log เพื่อตรวจสอบข้อมูลที่ได้รับ
      document.getElementById('fighter1-port').textContent = status.fighterPort1 || 'ไม่ระบุ';
      document.getElementById('fighter2-port').textContent = status.fighterPort2 || 'ไม่ระบุ';

      const status1 = document.getElementById('fighter1-status');
      status1.textContent = status.fighterPort1 ? 'เชื่อมต่อแล้ว' : 'ยังไม่เชื่อมต่อ';
      status1.classList.toggle('connected', !!status.fighterPort1);
      status1.classList.toggle('disconnected', !status.fighterPort1);

      const status2 = document.getElementById('fighter2-status');
      status2.textContent = status.fighterPort2 ? 'เชื่อมต่อแล้ว' : 'ยังไม่เชื่อมต่อ';
      status2.classList.toggle('connected', !!status.fighterPort2);
      status2.classList.toggle('disconnected', !status.fighterPort2);

    document.getElementById('fighter1-header').textContent = `ข้อมูล Real-time <%= fighter1.name %> (${status.fighterPort1 || 'ไม่ระบุ'})`;
    document.getElementById('fighter2-header').textContent = `ข้อมูล Real-time <%= fighter2.name %> (${status.fighterPort2 || 'ไม่ระบุ'})`;

    
    });

    socket.on('COM_PORT_1_DATA', (data) => {
      console.log('📥 COM_PORT_1_DATA:', data);
      const currentTimeSec = startTime ? Math.floor((Date.now() - startTime) / 1000) : 0;
      Object.keys(data).forEach(pos => {
        addRealtimeData('นักชก1', pos, data[pos], currentTimeSec);
        addTableRow('fighter1Table', pos, data[pos], currentTimeSec);
      });
    });

    socket.on('COM_PORT_2_DATA', (data) => {
      console.log('📥 COM_PORT_2_DATA:', data);
      const currentTimeSec = startTime ? Math.floor((Date.now() - startTime) / 1000) : 0;
      Object.keys(data).forEach(pos => {
        addRealtimeData('นักชก2', pos, data[pos], currentTimeSec);
        addTableRow('fighter2Table', pos, data[pos], currentTimeSec);
      });
    });

    socket.on('connectionError', (message) => {
      console.error('🚫 Connection error:', message);
      alert(message);
    });

    // ฟังก์ชันอัปเดตสถานะปุ่มทั้งหมด (เริ่ม + สลับ) ตาม COM
    function updateControlButtonsState() {
      const status1 = document.getElementById('fighter1-status');
      const status2 = document.getElementById('fighter2-status');
      const startBtn = document.getElementById('startBtn');
      const swapBtn = document.getElementById('swapBtn');

      if (!status1 || !status2) return;

      // เชื่อมต่ออย่างน้อย 1 ฝั่ง = ใช้งานได้ทั้งสองปุ่ม
      const atLeastOneConnected = 
        status1.classList.contains('connected') || 
        status2.classList.contains('connected');

      // ปุ่มเริ่มการแข่งขัน
      if (startBtn) {
        startBtn.disabled = !atLeastOneConnected;
        startBtn.textContent = atLeastOneConnected 
          ? '🎥 เริ่มการแข่งขัน' 
          : '🎥 เริ่มการแข่งขัน (รอเชื่อมต่อ COM)';
        startBtn.title = atLeastOneConnected 
          ? 'พร้อมเริ่มการแข่งขันแล้ว' 
          : 'ต้องเชื่อมต่อ COM port อย่างน้อย 1 ฝั่งก่อน';
      }

      // ปุ่มสลับพอร์ตนักชก (เดียวกัน)
      if (swapBtn) {
        swapBtn.disabled = !atLeastOneConnected;
        swapBtn.textContent = atLeastOneConnected 
          ? '🔄 สลับพอร์ตนักชก' 
          : '🔄 สลับพอร์ตนักชก (รอเชื่อมต่อ COM)';
        swapBtn.title = atLeastOneConnected 
          ? 'สลับพอร์ตนักชก 1 กับ 2' 
          : 'ต้องเชื่อมต่อ COM port อย่างน้อย 1 ฝั่งก่อนถึงจะสลับได้';
      }
    }

    // เรียกครั้งแรกตอนโหลดหน้า (เผื่อ socket ช้า)
    window.addEventListener('DOMContentLoaded', () => {
      socket.emit('requestConnectionStatus');
      setTimeout(updateControlButtonsState, 800);
    });

    function swapPorts() {
      socket.emit('swapCOMPorts');
      alert('กำลังสลับพอร์ตนักชก...');
    }

    function addRealtimeData(label, position, value, timeHitSec = 0) {
      console.log(`💾 addRealtimeData: label=${label}, position=${position}, value=${value}, timeHitSec=${timeHitSec}`);
      realtimeData.push({
        label,
        position,
        value: `${value}|${timeHitSec}`,
        fighterdetail: `${label} ${value} ${position}`
      });
    }

    function addTableRow(tableId, position, value, timeSec) {
      const tbody = document.querySelector(`#${tableId} tbody`);
      const tr = document.createElement('tr');
      const elapsedStr = startTime 
        ? `${Math.floor(timeSec / 60)}:${(timeSec % 60).toString().padStart(2, '0')}`
        : '0:00';
      tr.innerHTML = `
        <td>${elapsedStr}</td>
        <td>${position}</td>
        <td>${value}</td>
      `;
      tbody.prepend(tr);
      while (tbody.children.length > 20) {
        tbody.removeChild(tbody.lastChild);
      }
      tbody.parentElement.scrollTop = 0;
    }

    async function startRecording() {
  if (startTime) {
    alert('กำลังบันทึกอยู่แล้ว! กรุณากด "จบการแข่งขัน" ก่อน');
    return;
  }

  startTime = Date.now();
  recordedChunks1 = [];
  recordedChunks2 = [];
  recordedChunks3 = [];
  recordedChunks4 = [];
  realtimeData = [];

  try {
    // ดึงรายการอุปกรณ์
    const devices = await navigator.mediaDevices.enumerateDevices();
    const videoInputs = devices.filter(device => device.kind === 'videoinput');

    console.log('พบกล้องก่อน permission:', videoInputs.map(d => ({ label: d.label, id: d.deviceId })));

    // ถ้ายังไม่เห็นกล้องเลย → ขออนุญาตก่อน
    if (videoInputs.length === 0 || !videoInputs.some(d => d.deviceId && d.deviceId !== '')) {
      const initialStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
      initialStream.getTracks().forEach(track => track.stop());

      // อัปเดต devices หลัง permission
      const refreshedDevices = await navigator.mediaDevices.enumerateDevices();
      videoInputs.length = 0;
      videoInputs.push(...refreshedDevices.filter(d => d.kind === 'videoinput'));

      console.log('พบกล้องหลัง permission:', videoInputs.map(d => ({ label: d.label, id: d.deviceId })));
    }

    if (videoInputs.length === 0) {
      throw new Error('ไม่พบกล้องใด ๆ แม้หลังขออนุญาต');
    }

    // -------------------------------
    // กล้อง 1 (ตัวแรกเสมอ)
    // -------------------------------
    const deviceId1 = videoInputs[0].deviceId;
    stream1 = await navigator.mediaDevices.getUserMedia({
      video: deviceId1 ? { deviceId: { exact: deviceId1 } } : true,
      audio: false
    });
    document.getElementById('cam1').srcObject = stream1;
    await document.getElementById('cam1').play().catch(e => console.warn('เล่น cam1 ล้มเหลว:', e));

    mediaRecorder1 = new MediaRecorder(stream1);
    mediaRecorder1.ondataavailable = e => {
      if (e.data.size > 0) recordedChunks1.push(e.data);
    };
    mediaRecorder1.start();

    // -------------------------------
    // กล้อง 2
    // -------------------------------
    let cameraCount = 1;
    stream2 = null; mediaRecorder2 = null;

    if (videoInputs.length >= 2) {
      try {
        const deviceId2 = videoInputs[1].deviceId;
        stream2 = await navigator.mediaDevices.getUserMedia({
          video: deviceId2 ? { deviceId: { exact: deviceId2 } } : true,
          audio: false
        });
        document.getElementById('cam2').srcObject = stream2;
        await document.getElementById('cam2').play().catch(e => console.warn('เล่น cam2 ล้มเหลว:', e));

        mediaRecorder2 = new MediaRecorder(stream2);
        mediaRecorder2.ondataavailable = e => {
          if (e.data.size > 0) recordedChunks2.push(e.data);
        };
        mediaRecorder2.start();

        cameraCount++;
      } catch (err2) {
        console.warn('เปิดกล้อง 2 ล้มเหลว:', err2);
      }
    }

    // -------------------------------
    // กล้อง 3
    // -------------------------------
    stream3 = null; mediaRecorder3 = null;

    if (videoInputs.length >= 3) {
      try {
        const deviceId3 = videoInputs[2].deviceId;
        stream3 = await navigator.mediaDevices.getUserMedia({
          video: deviceId3 ? { deviceId: { exact: deviceId3 } } : true,
          audio: false
        });
        document.getElementById('cam3').srcObject = stream3;
        await document.getElementById('cam3').play().catch(e => console.warn('เล่น cam3 ล้มเหลว:', e));

        mediaRecorder3 = new MediaRecorder(stream3);
        mediaRecorder3.ondataavailable = e => {
          if (e.data.size > 0) recordedChunks3.push(e.data);
        };
        mediaRecorder3.start();

        cameraCount++;
      } catch (err3) {
        console.warn('เปิดกล้อง 3 ล้มเหลว:', err3);
      }
    }

    // -------------------------------
    // กล้อง 4
    // -------------------------------
    stream4 = null; mediaRecorder4 = null;

    if (videoInputs.length >= 4) {
      try {
        const deviceId4 = videoInputs[3].deviceId;
        stream4 = await navigator.mediaDevices.getUserMedia({
          video: deviceId4 ? { deviceId: { exact: deviceId4 } } : true,
          audio: false
        });
        document.getElementById('cam4').srcObject = stream4;
        await document.getElementById('cam4').play().catch(e => console.warn('เล่น cam4 ล้มเหลว:', e));

        mediaRecorder4 = new MediaRecorder(stream4);
        mediaRecorder4.ondataavailable = e => {
          if (e.data.size > 0) recordedChunks4.push(e.data);
        };
        mediaRecorder4.start();

        cameraCount++;
      } catch (err4) {
        console.warn('เปิดกล้อง 4 ล้มเหลว:', err4);
      }
    }

    document.getElementById('stopBtn').disabled = false;

    alert(`เริ่มบันทึกเรียบร้อยแล้ว (พบและเปิดได้ ${cameraCount} กล้อง)`);

  } catch (err) {
    startTime = null;
    console.error('เปิดกล้องหรือเริ่มบันทึกล้มเหลว:', err.name, err.message);

    let msg = 'เกิดข้อผิดพลาดในการเปิดกล้อง: ' + err.message;
    if (err.name === 'NotAllowedError' || err.name === 'PermissionDeniedError') {
      msg = 'คุณยังไม่ได้อนุญาตให้เว็บเข้าถึงกล้อง\nกรุณาอนุญาตใน popup ของเบราว์เซอร์ แล้วลองกดเริ่มใหม่';
    } else if (err.name === 'NotFoundError' || err.name === 'OverconstrainedError') {
      msg = 'ไม่พบกล้องหรือไม่สามารถใช้กล้องที่ระบุได้\nกรุณาตรวจสอบว่ากล้องเสียบอยู่และไม่ได้ถูกใช้งานโดยโปรแกรมอื่น';
    }
    alert(msg);

    // หยุดทุก stream ที่อาจเปิดค้างไว้
    [stream1, stream2, stream3, stream4].forEach(s => {
      if (s) s.getTracks().forEach(track => track.stop());
    });
    stream1 = stream2 = stream3 = stream4 = null;

    // ล้าง srcObject ทุกตัว
    ['cam1', 'cam2', 'cam3', 'cam4'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.srcObject = null;
    });
  }
}

    async function stopRecording() {
  try {
    // หยุด recorder และเก็บ blob
    let blob1 = null, blob2 = null, blob3 = null, blob4 = null;

    if (mediaRecorder1 && (mediaRecorder1.state === 'recording' || mediaRecorder1.state === 'paused')) {
      await new Promise(resolve => {
        mediaRecorder1.onstop = () => resolve();
        mediaRecorder1.stop();
      });
      blob1 = new Blob(recordedChunks1, { type: 'video/webm' });
    }

    if (mediaRecorder2 && (mediaRecorder2.state === 'recording' || mediaRecorder2.state === 'paused')) {
      await new Promise(resolve => {
        mediaRecorder2.onstop = () => resolve();
        mediaRecorder2.stop();
      });
      blob2 = new Blob(recordedChunks2, { type: 'video/webm' });
    }

    if (mediaRecorder3 && (mediaRecorder3.state === 'recording' || mediaRecorder3.state === 'paused')) {
      await new Promise(resolve => {
        mediaRecorder3.onstop = () => resolve();
        mediaRecorder3.stop();
      });
      blob3 = new Blob(recordedChunks3, { type: 'video/webm' });
    }

    if (mediaRecorder4 && (mediaRecorder4.state === 'recording' || mediaRecorder4.state === 'paused')) {
      await new Promise(resolve => {
        mediaRecorder4.onstop = () => resolve();
        mediaRecorder4.stop();
      });
      blob4 = new Blob(recordedChunks4, { type: 'video/webm' });
    }

    // อัปโหลดวิดีโอ (เหมือนเดิม)
    let clipUrl1 = '', clipUrl2 = '' ,clipUrl3 = '',clipUrl4 = '';

    if (blob1?.size > 0) {
      const fd1 = new FormData();
      fd1.append('video', blob1, 'fight_cam1.webm');
      const res1 = await fetch('/upload-video', { method: 'POST', body: fd1 });
      const json1 = await res1.json();
      if (json1.success) clipUrl1 = json1.url;
    }

    if (blob2?.size > 0) {
      const fd2 = new FormData();
      fd2.append('video', blob2, 'fight_cam2.webm');
      const res2 = await fetch('/upload-video', { method: 'POST', body: fd2 });
      const json2 = await res2.json();
      if (json2.success) clipUrl2 = json2.url;
    }

    if (blob3?.size > 0) {
      const fd3 = new FormData();
      fd3.append('video', blob3, 'fight_cam3.webm');
      const res3 = await fetch('/upload-video', { method: 'POST', body: fd3 });
      const json3 = await res3.json();
      if (json3.success) clipUrl3 = json3.url;
    }

    if (blob4?.size > 0) {
      const fd4 = new FormData();
      fd4.append('video', blob4, 'fight_cam4.webm');
      const res4 = await fetch('/upload-video', { method: 'POST', body: fd4 });
      const json4 = await res4.json();
      if (json4.success) clipUrl4 = json4.url;
    }

    // คำนวณเวลาและบันทึกข้อมูล (เหมือนเดิม)
    const durationMs = Date.now() - startTime;
    const totalSeconds = Math.floor(durationMs / 1000);
    const fightDuration = `${Math.floor(totalSeconds / 60)}:${(totalSeconds % 60).toString().padStart(2, '0')}`;

    const saveRes = await fetch('/datafight/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        schedulefight_id: "<%= schedulefightId %>",
        clip_url: clipUrl1,
        clip_url2: clipUrl2,
        clip_url3: clipUrl3,
        clip_url4: clipUrl4,
        time: fightDuration,
        data: realtimeData,
        round: roundNumber
      })
    });

    const saveData = await saveRes.json();
    if (!saveData.success) throw new Error('บันทึกข้อมูลล้มเหลว');

    roundsData.push({
      round: roundNumber,
      fightDuration,
      videoUrl: clipUrl1,
      videoUrl2: clipUrl2,
      clip_url3: clipUrl3,
      clip_url4: clipUrl4,
      data: [...realtimeData]
    });
    roundNumber++;

    alert('บันทึกข้อมูลเรียบร้อยแล้ว' + (clipUrl1 || clipUrl2 || clipUrl3 || clipUrl4 ? ' (รวมวิดีโอ)' : ' (ไม่มีวิดีโอ)'));

    document.getElementById('stopBtn').disabled = true;

    // หยุดและล้าง stream ทั้งสองตัว
    if (stream1) {
      stream1.getTracks().forEach(track => track.stop());
      stream1 = null;
    }
    if (stream2) {
      stream2.getTracks().forEach(track => track.stop());
      stream2 = null;
    }
    if (stream3) {
      stream3.getTracks().forEach(track => track.stop());
      stream3 = null;
    }
    if (stream4) {
      stream4.getTracks().forEach(track => track.stop());
      stream4 = null;
    }

    document.getElementById('cam1').srcObject = null;
    document.getElementById('cam2').srcObject = null;
    document.getElementById('cam3').srcObject = null;
    document.getElementById('cam4').srcObject = null;

    // แค่ reload หน้าเว็บเฉย ๆ (ตามที่คุณต้องการ)
    window.location.reload();

    // ล้าง realtime table
    realtimeData = [];
    document.querySelector('#fighter1Table tbody').innerHTML = '';
    document.querySelector('#fighter2Table tbody').innerHTML = '';

  } catch (error) {
    console.error('เกิดข้อผิดพลาด:', error);
    alert('เกิดข้อผิดพลาด: ' + error.message);
  }
}

    async function testCameras() {
  try {
    // ขออนุญาตและดึงรายการอุปกรณ์ก่อน
    await navigator.mediaDevices.getUserMedia({ video: true }); // ขออนุญาตครั้งแรก (เบราว์เซอร์จะถามที่นี่)
    const devices = await navigator.mediaDevices.enumerateDevices();
    const videoInputs = devices.filter(device => device.kind === 'videoinput');

    console.log('พบกล้องทั้งหมด:', videoInputs.map(d => d.label || d.deviceId));

    if (videoInputs.length === 0) {
      alert('ไม่พบกล้องใด ๆ ในระบบเลย กรุณาเสียบกล้องหรือตรวจสอบการตั้งค่า');
      return;
    }

    const modal = document.getElementById('cameraTestModal');
    const testCam1 = document.getElementById('testCam1');
    const testCam2 = document.getElementById('testCam2');

    // เปิดกล้องตัวที่ 1 เสมอ (ตัวแรกในลิสต์)
    const stream1 = await navigator.mediaDevices.getUserMedia({
      video: { deviceId: { exact: videoInputs[0].deviceId } }
    });
    testCam1.srcObject = stream1;
    testCam1.style.display = 'block';
    testCam1.play().catch(err => console.error('เล่น cam1 ล้มเหลว:', err));

    // ถ้ามีกล้องตัวที่ 2 → เปิดด้วย
    if (videoInputs.length >= 2) {
      const stream2 = await navigator.mediaDevices.getUserMedia({
        video: { deviceId: { exact: videoInputs[1].deviceId } }
      });
      testCam2.srcObject = stream2;
      testCam2.style.display = 'block';
      testCam2.play().catch(err => console.error('เล่น cam2 ล้มเหลว:', err));
      alert('เปิดทั้งสองกล้องเรียบร้อยแล้ว!');
    } else {
      testCam2.style.display = 'none';
      alert('พบแค่กล้องตัวเดียว เปิดเฉพาะกล้อง 1');
    }

    modal.style.display = 'flex';

    // เก็บ stream ไว้เพื่อปิดตอนปิด modal
    window.testStreams = { stream1, stream2: videoInputs.length >= 2 ? stream2 : null };

  } catch (err) {
    console.error('ทดสอบกล้องล้มเหลว:', err);
    if (err.name === 'NotAllowedError') {
      alert('คุณยังไม่ได้อนุญาตให้เว็บเข้าถึงกล้อง กรุณาอนุญาตแล้วลองใหม่');
    } else if (err.name === 'NotFoundError') {
      alert('ไม่พบกล้องในระบบ กรุณาเสียบกล้องแล้วลองใหม่');
    } else {
      alert('เกิดข้อผิดพลาด: ' + err.message);
    }
  }
}

function closeCameraTestModal() {
  const modal = document.getElementById('cameraTestModal');
  const testCam1 = document.getElementById('testCam1');
  const testCam2 = document.getElementById('testCam2');

  // หยุด stream ทั้งสองตัว
