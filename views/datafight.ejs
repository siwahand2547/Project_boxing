    // ล้างของเก่าทั้งหมดก่อน
    closeCameraTestModal(false);

    info.textContent = `กำลังทดสอบ ${videoInputs.length} กล้อง...`;

    modal.style.display = 'flex';

    testStreams = [];

    // สร้าง video element สำหรับแต่ละกล้อง
    videoInputs.forEach((device, index) => {
      const wrapper = document.createElement('div');
      wrapper.style.textAlign = 'center';

      const label = document.createElement('h4');
      label.textContent = `กล้อง ${index + 1} - ${device.label || 'ไม่ระบุชื่อ'}`;
      wrapper.appendChild(label);

      const video = document.createElement('video');
      video.id = `testCam-${index}`;
      video.autoplay = true;
      video.playsInline = true;
      video.style.width = '100%';
      video.style.background = '#000';
      video.style.borderRadius = '8px';
      wrapper.appendChild(video);

      container.appendChild(wrapper);

      // พยายามเปิดกล้อง
      navigator.mediaDevices.getUserMedia({
        video: { deviceId: { exact: device.deviceId } }
      })
      .then(stream => {
        testStreams[index] = stream;
        video.srcObject = stream;
        video.play().catch(e => console.warn(`เล่นกล้อง ${index+1} ล้มเหลว`, e));
      })
      .catch(err => {
        console.warn(`เปิดกล้อง ${index+1} ล้มเหลว:`, err);
        video.style.display = 'none';
        const errorMsg = document.createElement('p');
        errorMsg.textContent = 'เปิดไม่ได้';
        errorMsg.style.color = '#ef4444';
        wrapper.appendChild(errorMsg);
      });
    });

    info.textContent = `เปิดทดสอบ ${videoInputs.length} กล้องเรียบร้อย (เลื่อนดูได้ถ้ามีหลายตัว)`;

  } catch (err) {
    console.error('ทดสอบกล้องล้มเหลว:', err);
    let msg = err.name === 'NotAllowedError' 
      ? 'กรุณาอนุญาตให้เว็บเข้าถึงกล้องก่อน' 
      : 'เกิดข้อผิดพลาดในการทดสอบกล้อง';
    alert(msg);
  }
}

function closeCameraTestModal(hideModal = true) {
  console.log('กำลังปิด modal ทดสอบกล้อง → หยุด stream ทั้งหมด');

  // หยุดทุก stream ที่เก็บไว้
  if (testStreams && Array.isArray(testStreams)) {
    testStreams.forEach((stream, index) => {
      if (stream && typeof stream.getTracks === 'function') {
        const tracks = stream.getTracks();
        console.log(`กล้อง ${index + 1}: พบ ${tracks.length} tracks`);
        tracks.forEach(track => {
          if (track.enabled) {
            track.stop();
            console.log(`หยุด track ${track.kind} ของกล้อง ${index + 1} สำเร็จ`);
          }
        });
      }
    });
  }

  // ล้าง array ให้สะอาด
  testStreams = [];

  // ล้าง container
  const container = document.getElementById('testCamerasContainer');
  if (container) {
    container.innerHTML = '';
    console.log('ล้าง container ทดสอบกล้องเรียบร้อย');
  }

  // ปิด modal
  if (hideModal) {
    const modal = document.getElementById('cameraTestModal');
    if (modal) {
      modal.style.display = 'none';
      console.log('ปิด modal ทดสอบกล้องเรียบร้อย');
    }
  }

  // เพิ่มการ double-check ว่าไม่มี stream ค้าง (optional แต่ช่วย debug)
  setTimeout(() => {
    console.log('หลังปิด 2 วินาที → ตรวจสอบว่า webcam ยัง active อยู่หรือไม่');
  }, 2000);
}

function openClipModal(url1, url2, url3, url4, timehit, timestamps, round) {
  console.log('openClipModal called!', { url1, url2, url3, url4, timehit, round, timestampsLength: timestamps?.length });
  const decodedUrl1 = url1 || '';
  const decodedUrl2 = url2 || '';
  const decodedUrl3 = url3 || '';
  const decodedUrl4 = url4 || '';
  const decodedTimehit = decodeURIComponent(timehit || '00:00:00');

  const modal = document.getElementById('clipModal');
  const video1 = document.getElementById('clipVideo1');
  const video2 = document.getElementById('clipVideo2');
  const video3 = document.getElementById('clipVideo3');
  const video4 = document.getElementById('clipVideo4');
  const timestampContainer = document.getElementById('timestampButtons');

  modal.style.display = 'flex';
  video1.style.display = decodedUrl1 ? 'block' : 'none';
  video2.style.display = decodedUrl2 ? 'block' : 'none';
  video3.style.display = decodedUrl3 ? 'block' : 'none';
  video4.style.display = decodedUrl4 ? 'block' : 'none';

  video1.pause();
  video2.pause();
  video3.pause();
  video4.pause();
  video1.removeAttribute('src');
  video2.removeAttribute('src');
  video3.removeAttribute('src');
  video4.removeAttribute('src');

  if (decodedUrl1) video1.src = decodedUrl1;
  if (decodedUrl2) video2.src = decodedUrl2;
  if (decodedUrl3) video3.src = decodedUrl3;
  if (decodedUrl4) video4.src = decodedUrl4;

  video1.load();
  video2.load();
  video3.load();
  video4.load();

  // แยก timestamps เป็น 2 กลุ่มตามนักชก
  const fighter1Timestamps = timestamps.filter(ts => 
    ts.detail.includes('นักชก1') || ts.detail.includes('<%= fighter1.name %>')
  );
  const fighter2Timestamps = timestamps.filter(ts => 
    ts.detail.includes('นักชก2') || ts.detail.includes('<%= fighter2.name %>')
  );

  // สร้าง HTML แยก 2 ฝั่งสวยงาม
  let html = '<div class="timestamp-section">';
  
  // ฝั่งนักชก 1
  html += '<div class="timestamp-group">';
  html += `<h4><%= fighter1.name %></h4>`;
  if (fighter1Timestamps.length === 0) {
    html += '<p style="text-align:center; color:#888;">ไม่มีเหตุการณ์</p>';
  } else {
    fighter1Timestamps.forEach(ts => {
      html += `<button onclick="seekTo('${ts.timehit}')">${ts.timehit} (${ts.detail})</button>`;
    });
  }
  html += '</div>';

  // ฝั่งนักชก 2
  html += '<div class="timestamp-group">';
  html += `<h4><%= fighter2.name %></h4>`;
  if (fighter2Timestamps.length === 0) {
    html += '<p style="text-align:center; color:#888;">ไม่มีเหตุการณ์</p>';
  } else {
    fighter2Timestamps.forEach(ts => {
      html += `<button onclick="seekTo('${ts.timehit}')">${ts.timehit} (${ts.detail})</button>`;
    });
  }
  html += '</div>';

  html += '</div>';

  timestampContainer.innerHTML = html;

  // ตั้งเวลาเริ่มต้นเหมือนเดิม
  let seconds = hhmmssToSeconds(decodedTimehit) - 2;
  seconds = Math.max(0, seconds);

  const waitForVideo = (video) => new Promise(resolve => {
    if (!video.src) return resolve();
    video.onloadedmetadata = () => {
      video.currentTime = seconds;
      video.onseeked = () => resolve();
    };
    video.onerror = () => resolve();
  });

  Promise.all([waitForVideo(video1), waitForVideo(video2), waitForVideo(video3), waitForVideo(video4)])
    .then(() => {
      if (decodedUrl1) video1.play().catch(err => console.error(err));
      if (decodedUrl2) video2.play().catch(err => console.error(err));
      if (decodedUrl3) video3.play().catch(err => console.error(err));
      if (decodedUrl4) video4.play().catch(err => console.error(err));
    });
}

// ฟังก์ชันใหม่สำหรับ seek วิดีโอเมื่อกดปุ่ม timestamp
function seekTo(timehit) {
  const seconds = hhmmssToSeconds(timehit) - 2;
  const seekSec = Math.max(0, seconds);
  const video1 = document.getElementById('clipVideo1');
  const video2 = document.getElementById('clipVideo2');
  const video3 = document.getElementById('clipVideo3');
  const video4 = document.getElementById('clipVideo4');
  
  if (video1.src) {
    video1.currentTime = seekSec;
    video1.play().catch(e => console.error(e));
  }
  if (video2.src) {
    video2.currentTime = seekSec;
    video2.play().catch(e => console.error(e));
  }
  if (video3.src) {
    video3.currentTime = seekSec;
    video3.play().catch(e => console.error(e));
  }
  if (video4.src) {
    video4.currentTime = seekSec;
    video4.play().catch(e => console.error(e));
  }
}

    function closeClipModal() {
  const modal = document.getElementById('clipModal');
  if (!modal) return;

  ['clipVideo1','clipVideo2','clipVideo3','clipVideo4'].forEach(id => {
    const video = document.getElementById(id);
    if (video) {
      video.pause();
      video.removeAttribute('src');
      video.load();
    }
  });

  modal.style.display = 'none';
}

    function hhmmssToSeconds(hhmmss) {
      const parts = hhmmss.split(':').map(Number);
      return parts.length === 3 ? parts[0] * 3600 + parts[1] * 60 + parts[2] : 0;
    }

    function formatSeconds(sec) {
      const h = Math.floor(sec / 3600);
      const m = Math.floor((sec % 3600) / 60);
      const s = Math.floor(sec % 60);
      return [h, m, s].map(n => String(n).padStart(2, '0')).join(':');
    }

