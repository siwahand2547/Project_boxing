async function preloadCameras() {
  const preloadBtn = document.getElementById('preloadBtn');
  if (!preloadBtn) return;

  preloadBtn.disabled = true;
  preloadBtn.textContent = "⏳ กำลังเตรียมกล้อง...";

  try {
    // ขออนุญาตครั้งเดียวก่อน (เพื่อให้ label ชัดเจน และหลีกเลี่ยง popup ซ้ำ)
    await navigator.mediaDevices.getUserMedia({ video: true, audio: false })
      .then(s => { s.getTracks().forEach(t => t.stop()); })
      .catch(() => {});

    const devices = await navigator.mediaDevices.enumerateDevices();
    const videoInputs = devices.filter(d => d.kind === 'videoinput');

    if (videoInputs.length === 0) {
      alert("ไม่พบกล้องใด ๆ ในระบบเลย กรุณาตรวจสอบการเชื่อมต่อกล้อง");
      return;
    }

    // ล้าง stream เก่าทั้งหมดก่อน preload ใหม่
    Object.values(preloadedStreams).forEach(stream => {
      if (stream) {
        stream.getTracks().forEach(track => track.stop());
      }
    });

    // รีเซ็ต object
    preloadedStreams = {
      cam1: null,
      cam2: null,
      cam3: null,
      cam4: null
    };

    let openedCount = 0;

    // ────────────── กล้อง 1 ──────────────
    if (videoInputs.length >= 1 || selectedDeviceIds.cam1) {
      const deviceId = selectedDeviceIds.cam1 || videoInputs[0]?.deviceId;
      try {
        const stream = await navigator.mediaDevices.getUserMedia({
          video: deviceId ? { deviceId: { exact: deviceId } } : true,
          audio: false
        });
        preloadedStreams.cam1 = stream;
        openedCount++;
        // แสดงภาพเรียลไทม์ทันที (ดีมากสำหรับ UX)
        const videoEl = document.getElementById('cam1');
        if (videoEl) {
          videoEl.srcObject = stream;
          videoEl.play().catch(e => console.warn('เล่น cam1 ล้มเหลว', e));
        }
      } catch (err) {
        console.warn('Preload กล้อง 1 ล้มเหลว:', err);
      }
    }

    // ────────────── กล้อง 2 ──────────────
    if (videoInputs.length >= 2 || selectedDeviceIds.cam2) {
      const deviceId = selectedDeviceIds.cam2 || videoInputs[1]?.deviceId;
      try {
        const stream = await navigator.mediaDevices.getUserMedia({
          video: deviceId ? { deviceId: { exact: deviceId } } : true,
          audio: false
        });
        preloadedStreams.cam2 = stream;
        openedCount++;
        const videoEl = document.getElementById('cam2');
        if (videoEl) {
          videoEl.srcObject = stream;
          videoEl.play().catch(e => console.warn('เล่น cam2 ล้มเหลว', e));
        }
      } catch (err) {
        console.warn('Preload กล้อง 2 ล้มเหลว:', err);
      }
    }

    // ────────────── กล้อง 3 ──────────────
    if (videoInputs.length >= 3 || selectedDeviceIds.cam3) {
      const deviceId = selectedDeviceIds.cam3 || videoInputs[2]?.deviceId;
      try {
        const stream = await navigator.mediaDevices.getUserMedia({
          video: deviceId ? { deviceId: { exact: deviceId } } : true,
          audio: false
        });
        preloadedStreams.cam3 = stream;
        openedCount++;
        const videoEl = document.getElementById('cam3');
        if (videoEl) {
          videoEl.srcObject = stream;
          videoEl.play().catch(e => console.warn('เล่น cam3 ล้มเหลว', e));
        }
      } catch (err) {
        console.warn('Preload กล้อง 3 ล้มเหลว:', err);
      }
    }

    // ────────────── กล้อง 4 ──────────────
    if (videoInputs.length >= 4 || selectedDeviceIds.cam4) {
      const deviceId = selectedDeviceIds.cam4 || videoInputs[3]?.deviceId;
      try {
        const stream = await navigator.mediaDevices.getUserMedia({
          video: deviceId ? { deviceId: { exact: deviceId } } : true,
          audio: false
        });
        preloadedStreams.cam4 = stream;
        openedCount++;
        const videoEl = document.getElementById('cam4');
        if (videoEl) {
          videoEl.srcObject = stream;
          videoEl.play().catch(e => console.warn('เล่น cam4 ล้มเหลว', e));
        }
      } catch (err) {
        console.warn('Preload กล้อง 4 ล้มเหลว:', err);
      }
    }

    if (openedCount === 0) {
      alert("ไม่สามารถเปิดกล้องตัวใดตัวหนึ่งได้เลย กรุณาตรวจสอบการเชื่อมต่อและสิทธิ์");
    } else {
      alert(`เตรียมกล้องเรียบร้อยแล้ว (${openedCount} ตัว) กด "เริ่มการแข่งขัน" ได้เลย`);
      isPreloaded = true;
      document.getElementById('startBtn').disabled = false;
    }

  } catch (err) {
    console.error('เกิดข้อผิดพลาดในการ preload กล้อง:', err);
    let msg = 'เกิดข้อผิดพลาดในการเตรียมกล้อง\n';
    if (err.name === 'NotAllowedError') {
      msg += 'กรุณาอนุญาตให้เว็บเข้าถึงกล้อง';
    } else if (err.name === 'NotFoundError') {
      msg += 'ไม่พบกล้องที่ระบุ';
    } else {
      msg += err.message;
    }
    alert(msg);
  } finally {
    // คืนค่า button ให้กดได้อีก
    preloadBtn.disabled = false;
    preloadBtn.textContent = "📷 เตรียมกล้องล่วงหน้า";
  }
}
