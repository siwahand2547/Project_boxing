// ฟังก์ชันอัปเดตหน้าจอทั้งสองฝั่ง
function updateTimerDisplay() {
  const timeStr = `${Math.floor(elapsedSeconds / 60)}:${(elapsedSeconds % 60).toString().padStart(2, '0')}`;
  
  document.getElementById('timeDisplay1').textContent = timeStr;
  document.getElementById('timeDisplay2').textContent = timeStr;

  if (startTime) {
    document.getElementById('timer1')?.classList.add('running');
    document.getElementById('timer2')?.classList.add('running');
  } else {
    document.getElementById('timer1')?.classList.remove('running');
    document.getElementById('timer2')?.classList.remove('running');
  }

  // เตือน 10 วินาที (เหมือนเดิม)
  if (elapsedSeconds >= MAX_ROUND_SECONDS - 10 && elapsedSeconds < MAX_ROUND_SECONDS) {
    document.getElementById('timeDisplay1')?.classList.add('warning');
    document.getElementById('timeDisplay2')?.classList.add('warning');
  } else {
    document.getElementById('timeDisplay1')?.classList.remove('warning');
    document.getElementById('timeDisplay2')?.classList.remove('warning');
  }
}

async function stopRecording() {
  if (isStopping) {
    console.log("กำลังหยุดอยู่แล้ว → ข้ามการเรียก stopRecording ซ้ำ");
    return;
  }

  isStopping = true;

  try {
    console.log("เริ่มกระบวนการหยุดการบันทึก...");

    // 1. หยุด stream ทั้งหมดก่อน (เพื่อไม่ให้ MediaRecorder ยังจับภาพต่อ)
    [stream1, stream2, stream3, stream4].forEach((s, i) => {
      if (s) {
        console.log(`หยุด stream กล้อง ${i + 1}`);
        s.getTracks().forEach(track => track.stop());
      }
    });
    stream1 = stream2 = stream3 = stream4 = null;

    // ล้าง srcObject ของ video element ทันที
    ['cam1', 'cam2', 'cam3', 'cam4'].forEach(id => {
      const el = document.getElementById(id);
      if (el) {
        el.srcObject = null;
      }
    });

    // 2. หยุด MediaRecorder และสร้าง blob
    let blob1 = null, blob2 = null, blob3 = null, blob4 = null;

    const stopRecorder = (recorder, chunks) => {
      if (recorder && (recorder.state === 'recording' || recorder.state === 'paused')) {
        return new Promise(resolve => {
          recorder.onstop = () => resolve();
          recorder.stop();
        }).then(() => {
          if (chunks.length > 0) {
            return new Blob(chunks, { type: 'video/webm' });
          }
          return null;
        });
      }
      return Promise.resolve(null);
    };

    blob1 = await stopRecorder(mediaRecorder1, recordedChunks1);
    blob2 = await stopRecorder(mediaRecorder2, recordedChunks2);
    blob3 = await stopRecorder(mediaRecorder3, recordedChunks3);
    blob4 = await stopRecorder(mediaRecorder4, recordedChunks4);

    // 3. อัปโหลดวิดีโอ (เฉพาะที่มี blob)
    let clipUrl1 = '', clipUrl2 = '', clipUrl3 = '', clipUrl4 = '';

    const uploadVideo = async (blob, filename) => {
      if (!blob || blob.size === 0) return '';
      const fd = new FormData();
      fd.append('video', blob, filename);
      const res = await fetch('/upload-video', { method: 'POST', body: fd });
      const json = await res.json();
      return json.success ? json.url : '';
    };

    clipUrl1 = await uploadVideo(blob1, 'fight_cam1.webm');
    clipUrl2 = await uploadVideo(blob2, 'fight_cam2.webm');
    clipUrl3 = await uploadVideo(blob3, 'fight_cam3.webm');
    clipUrl4 = await uploadVideo(blob4, 'fight_cam4.webm');

    // 4. คำนวณเวลาและบันทึกข้อมูลลงฐานข้อมูล
    const durationMs = startTime ? Date.now() - startTime : 0;
    const totalSeconds = Math.floor(durationMs / 1000);
    const fightDuration = `${Math.floor(totalSeconds / 60)}:${(totalSeconds % 60).toString().padStart(2, '0')}`;

    const saveRes = await fetch('/datafight/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        schedulefight_id: "<%= schedulefightId %>",
        clip_url: clipUrl1,
        clip_url2: clipUrl2,
        clip_url3: clipUrl3,
        clip_url4: clipUrl4,
        time: fightDuration,
        data: realtimeData,
        round: roundNumber
      })
    });

    const saveData = await saveRes.json();
    if (!saveData.success) {
      throw new Error('บันทึกข้อมูลล้มเหลว: ' + (saveData.message || 'ไม่ทราบสาเหตุ'));
    }

    // 5. อัปเดต roundsData (ถ้ามี)
    roundsData.push({
      round: roundNumber,
      fightDuration,
      videoUrl: clipUrl1,
      videoUrl2: clipUrl2,
      clip_url3: clipUrl3,
      clip_url4: clipUrl4,
      data: [...realtimeData]
    });
    roundNumber++;

    // แจ้งผล
    const hasVideo = clipUrl1 || clipUrl2 || clipUrl3 || clipUrl4;
    alert('จบการแข่งขันและบันทึกข้อมูลเรียบร้อยแล้ว' + (hasVideo ? ' (รวมวิดีโอ)' : ' (ไม่มีวิดีโอ)'));

    // 6. รีเซ็ตสถานะทั้งหมด
    document.getElementById('stopBtn').disabled = true;
    document.getElementById('startBtn').disabled = false; // เปิดให้เริ่มรอบใหม่ได้

    realtimeData = [];
    document.querySelector('#fighter1Table tbody').innerHTML = '';
    document.querySelector('#fighter2Table tbody').innerHTML = '';

    // รีเซ็ต timer
    if (fightTimerInterval) {
      clearInterval(fightTimerInterval);
      fightTimerInterval = null;
    }

    startTime = null;
    elapsedSeconds = 0;
    updateTimerDisplay();

    document.getElementById('timer1')?.classList.remove('running');
    document.getElementById('timer2')?.classList.remove('running');

    // ถ้าต้องการ reload หน้า (ตามโค้ดเดิม)
    window.location.reload();

  } catch (error) {
    console.error('เกิดข้อผิดพลาดใน stopRecording:', error);
    alert('เกิดข้อผิดพลาดในการจบการแข่งขัน:\n' + (error.message || 'ไม่ทราบสาเหตุ'));
  } finally {
    isStopping = false;
    // ปลดล็อกให้สามารถกดหยุดซ้ำได้ (กรณีผู้ใช้กดปุ่มเอง)
  }
}

