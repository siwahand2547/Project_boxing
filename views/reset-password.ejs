<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ตั้งรหัสผ่านใหม่ - ระบบจัดการแข่งมวย</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- Google Fonts: Sarabun + Prompt (เหมือนหน้า login/register) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;500;600;700&family=Sarabun:wght@400;500;600&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #f0f4ff;              /* ฟ้าอ่อน ข้าวกรอบฟ้า */
      --card-bg: #ffffff;
      --primary: #3b82f6;         /* ฟ้าเข้ม (ปุ่มหลัก) */
      --primary-dark: #2563eb;
      --text-dark: #1e293b;
      --text-muted: #64748b;
      --gray-dark: #475569;       /* เทาเข้มสำหรับลิงก์ */
      --shadow: 0 10px 30px rgba(59, 130, 246, 0.08);
      --shadow-hover: 0 20px 40px rgba(59, 130, 246, 0.15);
    }

    body {
      font-family: 'Sarabun', 'Prompt', system-ui, sans-serif;
      background: var(--bg);
      color: var(--text-dark);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }

    .reset-container {
      max-width: 420px;
      width: 100%;
      animation: fadeIn 0.8s ease-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .logo-title {
      text-align: center;
      margin-bottom: 2.5rem;
    }

    .logo-title h1 {
      font-size: 2.25rem;
      font-weight: 700;
      color: var(--primary);
      margin-bottom: 0.5rem;
    }

    .logo-title p {
      font-size: 1.1rem;
      color: var(--text-muted);
      margin: 0;
    }

    .reset-card {
      background: var(--card-bg);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: var(--shadow);
      border: none;
      transition: all 0.3s ease;
    }

    .reset-card:hover {
      box-shadow: var(--shadow-hover);
    }

    .card-header {
      background: var(--primary);
      color: white;
      text-align: center;
      padding: 1.5rem;
      font-size: 1.4rem;
      font-weight: 600;
    }

    .card-body {
      padding: 2rem 1.75rem;
    }

    .form-label {
      font-weight: 500;
      color: var(--text-dark);
    }

    .form-control {
      border-radius: 10px;
      padding: 0.75rem 1.25rem;
      border: 1px solid #d1d5db;
      transition: all 0.25s ease;
    }

    .form-control:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 0.25rem rgba(59, 130, 246, 0.15);
    }

    .btn-reset {
      background: var(--primary);
      border: none;
      border-radius: 10px;
      padding: 0.85rem;
      font-size: 1.1rem;
      font-weight: 600;
      transition: all 0.3s ease;
    }

    .btn-reset:hover {
      background: var(--primary-dark);
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(59, 130, 246, 0.3);
    }

    .links {
      text-align: center;
      margin-top: 1.5rem;
      font-size: 0.95rem;
    }

    .links a {
      color: var(--gray-dark);           /* เทาเข้มตามธีม */
      text-decoration: none;
      font-weight: 500;
      transition: color 0.2s;
    }

    .links a:hover {
      color: var(--primary);
      text-decoration: underline;
    }

    .alert {
      border-radius: 10px;
      margin-bottom: 1.5rem;
    }

    @media (max-width: 576px) {
      .reset-container {
        padding: 0 1rem;
      }
      .logo-title h1 {
        font-size: 1.9rem;
      }
    }
  </style>
</head>
<body>

  <div class="reset-container">

    <div class="logo-title">
      <h1>ตั้งรหัสผ่านใหม่</h1>
      <p>กรุณาตั้งรหัสผ่านใหม่เพื่อใช้งานต่อ</p>
    </div>

    <!-- ข้อความแจ้งเตือน -->
    <% if (error_msg && error_msg.length > 0) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= error_msg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
    <% if (success_msg && success_msg.length > 0) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= success_msg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <div class="reset-card">
      <div class="card-header">
        ตั้งรหัสผ่านใหม่
      </div>
      <div class="card-body">
        <form action="/reset-password/<%= token %>" method="POST">
          <div class="mb-4">
            <label class="form-label">รหัสผ่านใหม่</label>
            <input 
              type="password" 
              name="password" 
              class="form-control" 
              required 
              minlength="6" 
              placeholder="อย่างน้อย 6 ตัวอักษร"
            >
          </div>

          <div class="mb-4">
            <label class="form-label">ยืนยันรหัสผ่าน</label>
            <input 
              type="password" 
              name="password2" 
              class="form-control" 
              required 
              minlength="6" 
              placeholder="ยืนยันรหัสผ่านอีกครั้ง"
            >
          </div>

          <button type="submit" class="btn btn-reset w-100">
            บันทึกรหัสผ่านใหม่
          </button>
        </form>

        <div class="links">
          <a href="/">ยกเลิก</a>
        </div>
      </div>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>