<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>เพิ่มนักมวย</title>
    <link rel="stylesheet" href="/styles.css">

    <!-- Google Fonts: Inter (มินิมอล ทันสมัย) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #f8f9fa;
            --card-bg: #ffffff;
            --text: #1f2937;
            --text-muted: #6b7280;
            --border: #e5e7eb;
            --accent: #3b82f6;
            --accent-hover: #2563eb;
            --shadow: 0 4px 12px rgba(0, 0, 0, 0.06);
            --shadow-hover: 0 10px 20px rgba(0, 0, 0, 0.1);
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            margin: 0;
            padding: 2.5rem 1.5rem;
            line-height: 1.6;
        }

        .container {
            max-width: 600px;
            margin: 0 auto;
        }

        h1 {
            font-size: 2rem;
            font-weight: 600;
            color: #111827;
            text-align: center;
            margin: 0 0 2.5rem 0;
        }

        .add-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 2rem;
            box-shadow: var(--shadow);
            transition: all 0.25s ease;
        }

        .add-card:hover {
            box-shadow: var(--shadow-hover);
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        label {
            display: block;
            font-weight: 500;
            color: #374151;
            margin-bottom: 0.5rem;
            font-size: 0.95rem;
        }

/* เพิ่มหรือแทนที่ในส่วน <style> เดิม */

input[type="text"],
input[type="file"] {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 1rem;
    background: #ffffff;
    color: #000000 !important;          /* บังคับให้ตัวอักษรเป็นสีดำชัดเจน */
    -webkit-text-fill-color: #000000 !important; /* แก้ autofill ใน Chrome/Safari */
    transition: all 0.2s ease;
    box-shadow: inset 0 1px 3px rgba(0,0,0,0.03);
}

input[type="text"]::placeholder {
    color: #9ca3af !important;          /* placeholder เทาอ่อน */
}

input[type="text"]:-webkit-autofill,
input[type="text"]:-webkit-autofill:hover,
input[type="text"]:-webkit-autofill:focus {
    -webkit-text-fill-color: #000000 !important; /* แก้ปัญหา autofill เป็นขาวใน Chrome */
    background-color: #ffffff !important;
    transition: background-color 5000s ease-in-out 0s; /* ป้องกัน flash */
}

        .btn-submit {
            width: 100%;
            padding: 0.9rem;
            background: var(--accent);
            color: white;
            font-weight: 500;
            font-size: 1rem;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
            margin-top: 1.5rem;
        }

        .btn-submit:hover {
            background: var(--accent-hover);
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(59,130,246,0.25);
        }

        .form-note {
            color: var(--text-muted);
            font-size: 0.875rem;
            margin-top: 0.5rem;
            text-align: center;
        }

        @media (max-width: 576px) {
            body { padding: 1.5rem 1rem; }
            .add-card { padding: 1.5rem; }
            h1 { font-size: 1.75rem; }
        }
    </style>
</head>
<body>

    <%- include('partials/navbar') %>

    <div class="container">
        <h1>เพิ่มนักมวย</h1>

        <div class="add-card">
            <form action="/fighters/add" method="POST" enctype="multipart/form-data">

                <div class="form-group">
                    <label for="name">ชื่อ:</label>
                    <input type="text" id="name" name="name" required>
                </div>

                <div class="form-group">
                    <label for="camp">ค่าย:</label>
                    <input type="text" id="camp" name="camp" required>
                </div>

                <div class="form-group">
                    <label for="weight_class">รุ่นน้ำหนัก:</label>
                    <input type="text" id="weight_class" name="weight_class" required>
                </div>

                <div class="form-group">
                    <label for="photo">รูปภาพ:</label>
                    <input type="file" id="photo" name="photo" accept="image/*">
                    <div class="form-note">รองรับไฟล์ .jpg, .png, .jpeg (ขนาดไม่เกิน 5MB)</div>
                </div>

                <button type="submit" class="btn-submit">บันทึกนักมวย</button>
            </form>
        </div>
    </div>

</body>
</html>